# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
*.egg

# Virtual environments
.venv/
venv/
env/

# uv

# Type checker caches
.mypy_cache/
.ty_cache/
.ruff_cache/

# Test results
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# Rust
/target/

# Pinned tool installs (just trestle-install)
/.tools/

# Node — the site (site/) root symlink points at site/node_modules so
# content/*.mdx can resolve component imports; server/ and emit/ each have their
# own. Ignore node_modules anywhere in the tree.
/node_modules
node_modules/

# Generated proto code (site/src/gen, server/src/gen) IS committed — CI
# regenerates and checks it is up to date (see just buf-gen).

# Local env files (secrets / connection strings). .env.example is tracked.
.env
.env.local
*.env
!.env.example
# Generated environments (envs/<name>/env.toml) render with inline local
# secrets: their env files are throwaway local credentials, committed so the
# stack runs from a checkout or the reader bundle.
!envs/*/.env
!envs/*/client/*.env
!envs/*/modules/*/.env/
!envs/*/modules/*/.env/*.env

# Generated site artifacts (built locally / in CI; not committed).
site/src/generated/content-versions.json

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
.isaac/

# Static target-site shells (sites/<name>/): the docs-factory emitter owns these
# paths and rewrites them on every emit; only the shell itself is committed.
sites/*/src/content/
sites/*/src/generated/
sites/*/src/vendor/
sites/*/public/
sites/*/.docs-emit.json
sites/*/dist/
sites/*/.ssr/

# review-feedback pull output (per-page snapshots of open review threads)
.review/

# scala-cli build state, next to any Scala script it runs
.scala-build/
.bsp/

# marimo session caches (marimo export / edit write __marimo__/ beside a notebook)
__marimo__/
