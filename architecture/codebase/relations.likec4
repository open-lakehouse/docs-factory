// Cross-repo edges, from manifests on each repo's default branch (ADR-0010).
// `via` is how the dependency is pulled; never a version or rev.

model {

  // --- trestle codegen: committed output of `trestle generate` --------------
  olai.mangrove.common -[generatedWith]-> olai.trestle.codegen "models generated by"
  olai.mangrove.client -[generatedWith]-> olai.trestle.codegen "client generated by"
  olai.distributary.common -[generatedWith]-> olai.trestle.codegen "models generated by"
  olai.distributary.api -[generatedWith]-> olai.trestle.codegen "handler traits generated by"
  olai.distributary.client -[generatedWith]-> olai.trestle.codegen "client generated by"

  // --- trestle runtime crates -----------------------------------------------
  olai.mangrove.client -[dependsOn]-> olai.trestle.http { metadata { via "crates.io" } }
  olai.mangrove.client -[dependsOn]-> olai.trestle.httpWasm "on wasm32" { metadata { via "crates.io" } }
  olai.mangrove.ucObjectStore -[dependsOn]-> olai.trestle.vendedStore { metadata { via "crates.io" } }
  olai.mangrove.common -[dependsOn]-> olai.trestle.store "optional (encryption)" { metadata { via "crates.io" } }
  olai.mangrove.postgres -[dependsOn]-> olai.trestle.store { metadata { via "crates.io" } }
  olai.mangrove.sqlite -[dependsOn]-> olai.trestle.store { metadata { via "crates.io" } }
  olai.mangrove.sharing -[dependsOn]-> olai.trestle.store { metadata { via "crates.io" } }
  olai.mangrove.storageAccess -[dependsOn]-> olai.trestle.storageCredentials { metadata { via "crates.io" } }
  olai.mangrove.server -[dependsOn]-> olai.trestle.credentialVending { metadata { via "crates.io" } }

  olai.headwaters.client -[dependsOn]-> olai.trestle.http "optional (cloud-auth)" { metadata { via "crates.io" } }

  olai.distributary.client -[dependsOn]-> olai.trestle.http { metadata { via "crates.io" } }
  olai.distributary.engine -[dependsOn]-> olai.trestle.vendedStore "optional (vending)" { metadata { via "crates.io" } }
  olai.distributary.provider -[dependsOn]-> olai.trestle.credentialVending { metadata { via "crates.io" } }
  olai.distributary.provider -[dependsOn]-> olai.trestle.store { metadata { via "crates.io" } }

  olai.hydrofoil.desktop -[dependsOn]-> olai.trestle.stackTopology { metadata { via "crates.io" } }

  olai.luminescent.shellCore -[dependsOn]-> olai.trestle.stackRuntime { metadata { via "crates.io" } }
  olai.luminescent.shellCore -[dependsOn]-> olai.trestle.stackState { metadata { via "crates.io" } }
  olai.luminescent.shellCore -[dependsOn]-> olai.trestle.stackTopology { metadata { via "crates.io" } }
  olai.luminescent.desktop -[dependsOn]-> olai.trestle.envEditor "UI" { metadata { via "git" } }
  olai.luminescent.desktop -[dependsOn]-> olai.trestle.host "UI" { metadata { via "git" } }

  // --- mangrove crates consumed elsewhere ------------------------------------
  olai.distributary.adminApi -[dependsOn]-> olai.mangrove.handlers { metadata { via "crates.io" } }
  olai.distributary.provider -[dependsOn]-> olai.mangrove.sharing { metadata { via "crates.io" } }
  olai.distributary.postgres -[dependsOn]-> olai.mangrove.sharing { metadata { via "crates.io" } }
  olai.distributary.sqlite -[dependsOn]-> olai.mangrove.sharing { metadata { via "crates.io" } }
  olai.distributary.server -[dependsOn]-> olai.mangrove.client "optional (unity)" { metadata { via "crates.io" } }
  olai.distributary.server -[dependsOn]-> olai.mangrove.storageAccess "optional (unity)" { metadata { via "crates.io" } }

  olai.hydrofoil.server -[dependsOn]-> olai.mangrove.client { metadata { via "git" } }
  olai.hydrofoil.server -[dependsOn]-> olai.mangrove.deltaApi { metadata { via "git" } }
  olai.hydrofoil.server -[dependsOn]-> olai.mangrove.ucDatafusion { metadata { via "git" } }
  olai.hydrofoil.deltaDatafusion -[dependsOn]-> olai.mangrove.ucDatafusion { metadata { via "git" } }
  olai.hydrofoil.portal -[dependsOn]-> olai.mangrove.ucObjectStore { metadata { via "git" } }
  olai.hydrofoil.ui -[dependsOn]-> olai.mangrove.ucUi "UI packages" { metadata { via "path" } }
  olai.hydrofoil.ui -[dependsOn]-> olai.mangrove.uiKit { metadata { via "path" } }

  // --- breakwater ------------------------------------------------------------
  olai.hydrofoil.server -[dependsOn]-> olai.breakwater.policyCedar { metadata { via "git" } }
  olai.hydrofoil.server -[dependsOn]-> olai.breakwater.cedarOci { metadata { via "git" } }

  // --- luminescent packages other repos' services -----------------------------
  olai.luminescent.headwatersNeon -[deploys]-> olai.headwaters.service "to Neon Functions" { metadata { via "git" } }
  olai.luminescent.unitycatalogNeon -[deploys]-> olai.mangrove.server "to Neon Functions" { metadata { via "git" } }
  olai.luminescent.opensharingNeon -[deploys]-> olai.distributary.server "to Neon Functions" { metadata { via "git" } }
  olai.luminescent.migrate -[dependsOn]-> olai.headwaters.service { metadata { via "git" } }
  olai.luminescent.migrate -[dependsOn]-> olai.mangrove.server { metadata { via "git" } }
  olai.luminescent.migrate -[dependsOn]-> olai.distributary.server { metadata { via "git" } }
  olai.luminescent -[deploys]-> neon "functions and branches"

  // --- Upstreams (load-bearing) ------------------------------------------------
  olai.mangrove -[builtOn]-> datafusion
  olai.mangrove -[builtOn]-> deltaKernel
  olai.mangrove -[builtOn]-> deltaRs
  olai.mangrove -[builtOn]-> objectStore
  olai.breakwater -[builtOn]-> datafusion
  olai.breakwater -[builtOn]-> cedar
  olai.hydrofoil -[builtOn]-> datafusion
  olai.hydrofoil -[builtOn]-> deltaRs
  olai.hydrofoil -[builtOn]-> datafusionOpenlineage
  olai.distributary -[builtOn]-> deltaKernel
  olai.distributary -[builtOn]-> objectStore
  olai.tributary -[builtOn]-> datafusion
  olai.trestle.codegen -[builtOn]-> protobuf "reads descriptors from"
  olai.trestle.stackRuntime -[builtOn]-> dockerCompose "runs environments on"
  olai.trestle.stackRuntime -[builtOn]-> neon "branches as an environment source"
  olai.trestle.vendedStore -[builtOn]-> objectStore
  olai.trestle.auth -[builtOn]-> cedar "embedded authorizer"
}
