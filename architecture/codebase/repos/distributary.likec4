// distributary — OpenSharing / Delta Sharing in Rust.

model {
  extend olai {
    distributary = repo "distributary" {
      description "OpenSharing / Delta Sharing: protocol models, a client, the protocol surface, an engine over pluggable ports, and a composable sharing server that maps shares onto a catalog."
      link https://github.com/open-lakehouse/distributary
      metadata {
        sourceRepo "open-lakehouse/distributary"
      }

      common = crate "opensharing-common" {
        #published
        description "Wire models (generated by trestle)."
      }
      api = crate "opensharing-api" {
        #published
        description "Protocol REST surface: generated handler traits, the NDJSON query trait, axum routers."
      }
      client = crate "opensharing-client" {
        #published
        description "Protocol client (generated by trestle)."
      }
      adminApi = crate "opensharing-admin-api" {
        #published
        description "Provider admin API surface: Unity Catalog share, recipient, and provider handlers."
      }
      engine = crate "opensharing-engine" {
        #published
        description "The protocol over pluggable ports, with a delta_kernel-backed Delta format."
      }
      provider = crate "opensharing-provider" {
        #published
        description "Provider domain: shares, recipients, tokens, grants, sealed secrets."
      }
      postgres = crate "opensharing-postgres" {
        #published
        description "Postgres implementation of the provider store traits."
      }
      sqlite = crate "opensharing-sqlite" {
        #published
        description "SQLite implementation of the provider store traits."
      }
      server = binary "sharing-server" {
        #published
        description "Batteries-included sharing server (serve, migrate, healthcheck, rotate-keys); Unity Catalog integration behind a feature."
        metadata { publishedAs "opensharing-server" }
      }
    }
  }

  olai.distributary.api -[dependsOn]-> olai.distributary.common
  olai.distributary.client -[dependsOn]-> olai.distributary.common
  olai.distributary.engine -[dependsOn]-> olai.distributary.api
  olai.distributary.provider -[dependsOn]-> olai.distributary.engine
  olai.distributary.provider -[dependsOn]-> olai.distributary.adminApi "optional"
  olai.distributary.postgres -[dependsOn]-> olai.distributary.provider
  olai.distributary.sqlite -[dependsOn]-> olai.distributary.provider
  olai.distributary.server -[dependsOn]-> olai.distributary.provider
  olai.distributary.server -[dependsOn]-> olai.distributary.postgres "optional"
  olai.distributary.server -[dependsOn]-> olai.distributary.sqlite "optional"
}
