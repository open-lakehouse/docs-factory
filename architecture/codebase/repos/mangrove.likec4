// mangrove — a pluggable Unity Catalog in Rust. Members of the root workspace
// plus the separate wasm/ workspace. Private UI packages beyond the ones below
// (data-grid, editor, query, files, log-query, …) are omitted.

model {
  extend olai {
    mangrove = repo "mangrove" {
      description "Unity Catalog in Rust: server, clients and bindings, pluggable stores, the Delta REST API, a DataFusion integration, and UI components."
      link https://github.com/open-lakehouse/mangrove
      metadata {
        sourceRepo "open-lakehouse/mangrove"
        lakehouseElement "mangrove"
      }

      common = crate "olai-uc-common" {
        #published
        description "Shared Unity Catalog models (generated by trestle) and storage/REST abstractions."
      }
      client = crate "olai-uc-client" {
        #published
        description "Async Rust client for the Unity Catalog REST API (generated by trestle)."
      }
      handlers = crate "olai-uc-handlers" {
        #published
        description "Resource-gated handler traits and axum routes."
      }
      deltaApi = crate "olai-uc-delta-api" {
        #published
        description "Unity Catalog Delta REST API, commit coordinator, and the DeltaBackend port."
      }
      ucDatafusion = crate "olai-uc-datafusion" {
        #published
        description "DataFusion catalog provider and Delta tables backed by Unity Catalog."
      }
      ucObjectStore = crate "olai-uc-object-store" {
        #published
        description "object_store implementation backed by Unity Catalog credential vending."
      }
      storageAccess = crate "olai-uc-storage-access" {
        #published
        description "Storage credentials and external locations store."
      }
      postgres = crate "olai-uc-postgres" {
        #published
        description "Postgres resource and secret store."
      }
      sqlite = crate "olai-uc-sqlite" {
        #published
        description "SQLite resource and secret store."
      }
      sharing = crate "olai-uc-sharing" {
        #published
        description "Delta Sharing provider state (shares, recipients); used by distributary, not by the server."
      }
      filesProto = crate "olai-uc-files-proto" {
        #published
        description "ConnectRPC FilesService contract (buffa)."
      }
      server = binary "uc-server" {
        #published
        description "Unity Catalog REST server with pluggable storage backends; also an embeddable library."
        metadata { publishedAs "olai-uc-server" }
      }
      ucCli = binary "uc" {
        #published
        description "Unity Catalog CLI for a running server."
        metadata { publishedAs "olai-uc-cli" }
      }
      filesApi = binary "files-api" {
        #published
        description "ConnectRPC files server over Unity Catalog volumes."
        metadata { publishedAs "olai-uc-files-api" }
      }
      storageProxy = binary "storage-proxy" {
        #published
        description "Same-origin storage byte proxy over governed volumes."
        metadata { publishedAs "olai-uc-storage-proxy" }
      }
      pyClient = pyPackage "unitycatalog-client" {
        #published
        description "Python client (PyO3 over olai-uc-client)."
      }
      nodeClient = npmPackage "@open-lakehouse/unity-catalog-node" {
        #published
        description "Node client (NAPI over olai-uc-client), with per-platform packages."
      }
      tsClient = npmPackage "@open-lakehouse/unity-catalog-client" {
        #published
        description "Typed Unity Catalog REST client and React Query hooks."
      }
      ucUi = npmPackage "@open-lakehouse/unity-catalog-ui" {
        #unpublished
        description "Unity Catalog browser components."
      }
      uiKit = npmPackage "@open-lakehouse/ui-kit (mangrove)" {
        #unpublished
        description "Headless React primitives (node/ui-kit, DESIGN.md contract). Same package name as trestle's ui-kit."
      }
      queryWasm = crate "olai-uc-query-wasm" {
        #unpublished #wasm
        description "In-browser table preview engine (separate wasm workspace)."
      }
      ucApp = app "uc-app" {
        #unpublished
        description "Vite web app over the Unity Catalog UI packages."
      }
    }
  }

  olai.mangrove.client -[dependsOn]-> olai.mangrove.common
  olai.mangrove.client -[dependsOn]-> olai.mangrove.deltaApi
  olai.mangrove.handlers -[dependsOn]-> olai.mangrove.common
  olai.mangrove.ucDatafusion -[dependsOn]-> olai.mangrove.client
  olai.mangrove.ucDatafusion -[dependsOn]-> olai.mangrove.ucObjectStore
  olai.mangrove.ucObjectStore -[dependsOn]-> olai.mangrove.client
  olai.mangrove.storageAccess -[dependsOn]-> olai.mangrove.common
  olai.mangrove.postgres -[dependsOn]-> olai.mangrove.storageAccess
  olai.mangrove.sqlite -[dependsOn]-> olai.mangrove.storageAccess
  olai.mangrove.sharing -[dependsOn]-> olai.mangrove.common
  olai.mangrove.filesApi -[dependsOn]-> olai.mangrove.filesProto
  olai.mangrove.server -[dependsOn]-> olai.mangrove.handlers
  olai.mangrove.server -[dependsOn]-> olai.mangrove.deltaApi
  olai.mangrove.server -[dependsOn]-> olai.mangrove.storageAccess
  olai.mangrove.server -[dependsOn]-> olai.mangrove.storageProxy
  olai.mangrove.server -[dependsOn]-> olai.mangrove.filesApi
  olai.mangrove.server -[dependsOn]-> olai.mangrove.postgres "optional"
  olai.mangrove.server -[dependsOn]-> olai.mangrove.sqlite "optional"
  olai.mangrove.ucCli -[dependsOn]-> olai.mangrove.client
  olai.mangrove.pyClient -[dependsOn]-> olai.mangrove.client
  olai.mangrove.nodeClient -[dependsOn]-> olai.mangrove.client
  olai.mangrove.queryWasm -[dependsOn]-> olai.mangrove.ucObjectStore
  olai.mangrove.ucUi -[dependsOn]-> olai.mangrove.tsClient
  olai.mangrove.ucUi -[dependsOn]-> olai.mangrove.uiKit
  olai.mangrove.ucApp -[dependsOn]-> olai.mangrove.ucUi
  olai.mangrove.ucApp -[dependsOn]-> olai.mangrove.queryWasm "via @open-lakehouse/query-wasm"
}
