// DEPLOYMENT views — one per topology. These show WHICH concrete service plays
// each logical capability / governance role, and the trust differences between
// topologies. #designed / #prototype elements render amber (tag colors in spec).

views {

  // --- 1. olai-native (trusted compute) ------------------------------------
  deployment view olaiNativeDeploy {
    title "Deployment — olai-native (trusted compute)"
    description "The reference deployment: an Envoy gateway fronts the stack as ONE API surface; hydrofoil is the trusted query engine enforcing full FGAC in-plan (embedded PDP + engine PEP); mangrove is the catalog + resource PIP + credential-vending PA. Auth-on makes the gateway an edge PEP."

    include olaiNative.**
    autoLayout LeftRight
  }

  // --- 2. external-engine (credential vending) — the FGAC bypass -----------
  deployment view externalEngineDeploy {
    title "Deployment — external engine (credential vending)"
    description "The catalog vends a scoped credential to an external, untrusted engine (Spark/Trino/notebook), which then reads raw files. Only coarse access is enforced — row filters and column masks are BYPASSED. The non-vendable-governed-table guard (amber) is the designed mitigation."

    include externalEngine.**
    autoLayout LeftRight
  }

  // --- 3. browser-wasm (client-side) ---------------------------------------
  deployment view browserWasmDeploy {
    title "Deployment — browser / WASM (client-side)"
    description "A client-side WASM query engine (axon) in the untrusted browser. The catalog issues signed URLs / proxies bytes rather than vending raw credentials — no raw cloud secrets reach the browser. Prototype."

    include browserWasm.**
    autoLayout LeftRight
  }
}
