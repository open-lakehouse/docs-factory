// The fully hosted Unity Catalog deployment pattern, for the deployment patterns
// page (content/unitycatalog/explanation/005-deployment-patterns). The local and
// hybrid patterns are generated environments (generated/uc-local.likec4,
// generated/uc-hybrid.likec4); no environment renders this one, so it is drawn
// by hand.

deployment {

  environment ucHosted "Fully hosted Unity Catalog" {

    workstation = environment "Your machine" {
      // Many implementations, so an instance of none of them.
      clients = service "Clients" {
        description "Engines, SDKs, and the CLI. They reach the catalog over its REST API and read and write Amazon S3 with the credentials it vends."
      }
    }

    cloud = environment "Cloud" {
      unityCatalog = service "Unity Catalog" {
        description "The catalog server, with authentication and authorization on. It keeps no catalog state of its own; its replicas share the signing keys in etc/conf and refresh their authorization policy from the database."
        instanceOf unityCatalogOSS
      }

      metastore = datastore "PostgreSQL" {
        description "A managed PostgreSQL database: the catalog's metadata."
        instanceOf postgresql
      }

      storage = datastore "Amazon S3" {
        description "Amazon S3 buckets with an IAM role the server assumes to vend credentials: the tables' and volumes' files."
        instanceOf amazonS3
      }
    }

    ucHosted.workstation.clients -[uses]-> ucHosted.cloud.unityCatalog "REST API over HTTPS"
    ucHosted.workstation.clients -[uses]-> ucHosted.cloud.storage "reads and writes files with vended credentials"
    ucHosted.cloud.unityCatalog -[uses]-> ucHosted.cloud.metastore "PostgreSQL"
    ucHosted.cloud.unityCatalog -[uses]-> ucHosted.cloud.storage "S3"
  }
}
