deployment {

  environment trustedCompute {

    // hydrofoil — the integration hub: the query engine that enforces FGAC
    // in-plan. Plays queryEngine + embedded PDP + engine PEP.
    hydrofoil = service "hydrofoil" {
      description "The catalog-native query engine. Composes the catalog, policy, and lineage into one session and enforces full FGAC in-plan — it embeds the PDP (decide) and the PEP (enforce)."
      link https://github.com/open-lakehouse/hydrofoil

      metadata { sourceRepo "open-lakehouse/hydrofoil" }

      instanceOf lakehouse.queryEngine
    }

    mangrove = service "mangrove" {
      description "The catalog server. Governs securables, serves resource facts, and vends short-lived scoped credentials after an authorize check."
      link https://github.com/open-lakehouse/mangrove

      metadata { sourceRepo "open-lakehouse/mangrove" }

      instanceOf lakehouse.catalog
    }

    headwaters = service "headwaters" {
      description "Captures column-level lineage at planning time and ingests events into a queryable store. Its lineage capability is built; the dynamic lineage / taint PIP role that feeds the PDP is designed, not built."
      link https://github.com/open-lakehouse/headwaters

      metadata { sourceRepo "open-lakehouse/headwaters" }

      instanceOf lakehouse.lineage
    }

    // Object storage + relational store backing the stack.
    objstore = datastore "Object storage" {
      description "S3-compatible object storage where table files are written."

      instanceOf lakehouse.objectStorage
    }

    postgres = datastore "Postgres" {
      description "Relational store backing the catalog and lineage services."
    }
  }
}
