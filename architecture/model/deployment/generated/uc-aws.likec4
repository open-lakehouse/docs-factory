// Generated by `docsnip envs --fix` from envs/uc-aws/plan.json. Don't edit:
// change envs/uc-aws/env.toml and run `just env-render uc-aws`.

deployment {

  environment ucAws "uc-aws (generated)" {
    #generated

    envoy = service "envoy" {
      #generated
      description "Single-port gateway, Databricks-shaped URL rewrites."
      metadata { trestleModule "envoy" }
      instanceOf envoy
    }

    postgres = datastore "db" {
      #generated
      description "Postgres 16; auto-creates DBs other modules declare."
      metadata { trestleModule "postgres" }
      instanceOf postgresql
    }

    rustfs = datastore "rustfs" {
      #generated
      description "Self-hosted S3-compatible object store with STS; answers the AWS S3/STS hostnames in-network."
      metadata { trestleModule "rustfs" }
      instanceOf rustfs
    }

    unityCatalog = service "unitycatalog" {
      #generated
      description "Open-source Unity Catalog server; Databricks-shaped REST API."
      metadata { trestleModule "unity-catalog" }
      instanceOf unityCatalogServer
    }

    ucAws.envoy -[flows]-> ucAws.unityCatalog ":8080 /api/2.1/unity-catalog, /unity-catalog" {
      metadata { trestleEdge "route:envoy→unity-catalog:8080" }
    }
    ucAws.envoy -[flows]-> ucAws.rustfs ":9000 /" {
      metadata { trestleEdge "route:envoy→rustfs:9000" }
    }
    ucAws.unityCatalog -[uses]-> ucAws.postgres "PostgreSQL" {
      metadata { trestleEdge "uses:unity-catalog→postgres:relational_db" }
    }
    ucAws.unityCatalog -[uses]-> ucAws.rustfs "S3" {
      metadata { trestleEdge "uses:unity-catalog→rustfs:object_store" }
    }
  }
}

views {

  deployment view ucAwsDeploy {
    title "Deployment — uc-aws (generated)"
    description "Rendered by Trestle from envs/uc-aws/env.toml."

    include ucAws.**
    autoLayout LeftRight
  }
}
