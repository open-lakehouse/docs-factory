// Generated by `docsnip envs --fix` from envs/uc-hybrid/plan.json. Don't edit:
// change envs/uc-hybrid/env.toml and run `just env-render uc-hybrid`.

deployment {

  environment ucHybrid "uc-hybrid (generated)" {
    #generated

    awsS3 = datastore "Amazon S3" {
      #generated
      description "Amazon S3 or an S3-compatible store; README.md sets up the buckets."
      metadata { trestleModule "aws-s3" }
      instanceOf amazonS3
    }

    hostedPostgres = datastore "Hosted Postgres" {
      #generated
      description "A managed PostgreSQL server (Neon, RDS, Azure, …); README.md sets it up."
      metadata { trestleModule "hosted-postgres" }
      instanceOf postgresql
    }

    unityCatalog = service "unitycatalog" {
      #generated
      description "Open-source Unity Catalog server; Databricks-shaped REST API."
      metadata { trestleModule "unity-catalog" }
      instanceOf unityCatalogServer
    }

    ucHybrid.unityCatalog -[uses]-> ucHybrid.hostedPostgres "PostgreSQL" {
      metadata { trestleEdge "uses:unity-catalog→hosted-postgres:relational_db" }
    }
    ucHybrid.unityCatalog -[uses]-> ucHybrid.awsS3 "S3" {
      metadata { trestleEdge "uses:unity-catalog→aws-s3:object_store" }
    }
  }
}

views {

  deployment view ucHybridDeploy {
    title "Deployment — uc-hybrid (generated)"
    description "Rendered by Trestle from envs/uc-hybrid/env.toml."

    include ucHybrid.**
    autoLayout LeftRight
  }
}
