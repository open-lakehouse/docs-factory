// Generated by `docsnip envs --fix` from envs/uc-mlflow/plan.json. Don't edit:
// change envs/uc-mlflow/env.toml and run `just env-render uc-mlflow`.

deployment {

  environment ucMlflow "uc-mlflow (generated)" {
    #generated

    envoy = service "envoy" {
      #generated
      description "Single-port gateway, Databricks-shaped URL rewrites."
      metadata { trestleModule "envoy" }
      instanceOf envoy
    }

    postgres = datastore "db" {
      #generated
      description "Postgres 16; auto-creates DBs other modules declare."
      metadata { trestleModule "postgres" }
      instanceOf postgresql
    }

    rustfs = datastore "rustfs" {
      #generated
      description "Self-hosted S3-compatible object store with STS; answers the AWS S3/STS hostnames in-network."
      metadata { trestleModule "rustfs" }
      instanceOf rustfs
    }

    unityCatalog = service "unitycatalog" {
      #generated
      description "Open-source Unity Catalog server; Databricks-shaped REST API."
      metadata { trestleModule "unity-catalog" }
      instanceOf unityCatalogServer
    }

    mlflow = service "mlflow" {
      #generated
      description "Experiment + model tracking and an AI Gateway; Databricks-shaped URLs."
      metadata { trestleModule "mlflow" }
      instanceOf mlflow
    }

    ucMlflow.envoy -[flows]-> ucMlflow.unityCatalog ":8080 /api/2.1/unity-catalog, /unity-catalog" {
      metadata { trestleEdge "route:envoy→unity-catalog:8080" }
    }
    ucMlflow.envoy -[flows]-> ucMlflow.mlflow ":8080 /api/2.0/mlflow, /api/2.0/otel, /ai-gateway, /mlflow" {
      metadata { trestleEdge "route:envoy→mlflow:8080" }
    }
    ucMlflow.envoy -[flows]-> ucMlflow.rustfs ":9000 /" {
      metadata { trestleEdge "route:envoy→rustfs:9000" }
    }
    ucMlflow.unityCatalog -[uses]-> ucMlflow.postgres "PostgreSQL" {
      metadata { trestleEdge "uses:unity-catalog→postgres:relational_db" }
    }
    ucMlflow.unityCatalog -[uses]-> ucMlflow.rustfs "S3" {
      metadata { trestleEdge "uses:unity-catalog→rustfs:object_store" }
    }
    ucMlflow.mlflow -[uses]-> ucMlflow.postgres "PostgreSQL" {
      metadata { trestleEdge "uses:mlflow→postgres:relational_db" }
    }
    ucMlflow.mlflow -[uses]-> ucMlflow.rustfs "S3" {
      metadata { trestleEdge "uses:mlflow→rustfs:object_store" }
    }
  }
}

views {

  deployment view ucMlflowDeploy {
    title "Deployment — uc-mlflow (generated)"
    description "Rendered by Trestle from envs/uc-mlflow/env.toml."

    include ucMlflow.**
    autoLayout LeftRight
  }
}
