// Generated by `docsnip envs --fix` from envs/unitycatalog/plan.json. Don't edit:
// change envs/unitycatalog/env.toml and run `just env-render unitycatalog`.

deployment {

  environment unitycatalog "unitycatalog (generated)" {
    #generated

    envoy = service "envoy" {
      #generated
      description "Single-port gateway, Databricks-shaped URL rewrites."
      metadata { trestleModule "envoy" }
      instanceOf envoy
    }

    unityCatalog = service "unitycatalog" {
      #generated
      description "Open-source Unity Catalog server; Databricks-shaped REST API."
      metadata { trestleModule "unity-catalog" }
      instanceOf unityCatalogOSS
    }

    unitycatalog.envoy -[flows]-> unitycatalog.unityCatalog ":8080 /api/2.1/unity-catalog, /unity-catalog" {
      metadata { trestleEdge "route:envoy→unity-catalog:8080" }
    }
  }
}

views {

  deployment view unitycatalogDeploy {
    title "Deployment — unitycatalog (generated)"
    description "Rendered by Trestle from envs/unitycatalog/env.toml."

    include unitycatalog.**
    autoLayout LeftRight
  }
}
