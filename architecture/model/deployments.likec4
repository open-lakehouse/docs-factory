// DEPLOYMENT LAYER (concrete) — our services realizing the reference lakehouse.
//
// Each `service` node is one of our repos manifesting in a topology; its
// `instanceOf` lines say which logical capabilities + governance roles it plays.
// One node can play several roles (hydrofoil = queryEngine + engine PEP + PDP).
// Deployment views inherit the logical relationships between instances; we add
// deployment-specific edges (gateway routing, credential vending) explicitly.
//
// Three trust-differentiated topologies:
//   1. olaiNative     — trusted compute; Envoy gateway = one API surface; full FGAC.
//   2. externalEngine — credential vending to Spark/Trino; FGAC BYPASSED.
//   3. browserWasm    — client-side WASM; signed-URL/proxy; no raw secrets.
//
// Repo identity lives here (sourceRepo + GitHub link), NOT in the logical layer.

deployment {

  // =========================================================================
  // 1. olai-native (trusted compute) — the reference deployment
  // =========================================================================
  environment olaiNative {
    #trusted

    // Envoy: the single-port gateway where the platform manifests as ONE API
    // surface. Generated by trestle's stack-topology crate. Edge PEP when auth-on.
    envoy = gateway "Envoy gateway" {
      #built
      description "Single-port API gateway. Path-multiplexes the backends onto one cohesive surface (+ a catch-all to the app). With ENVOY_AUTH on, wires an ext_authz/Authelia forward-auth edge PEP (fail-closed; strips client-forged identity headers)."
      metadata {
        sourceRepo "open-lakehouse/trestle (crates/stack-topology)"
        note "Envoy config + compose generated by olai-stack-topology; auth is opt-in via ENVOY_AUTH."
      }
      instanceOf lakehouse.governance.pep   // edge PEP (opt-in)
    }

    // hydrofoil — the integration hub: the trusted query engine that enforces
    // FGAC in-plan. Plays queryEngine + embedded PDP + engine PEP.
    hydrofoil = service "hydrofoil" {
      #built
      description "The catalog-native query engine (Flight SQL + ConnectRPC). Composes the catalog, policy, and lineage into one session and enforces full FGAC in-plan. Embeds the Cedar PDP and the engine PEP."
      link https://github.com/open-lakehouse/hydrofoil
      metadata {
        sourceRepo "open-lakehouse/hydrofoil"
        note "breakwater is embedded here as a library (decide/enforce). Depends on personal forks — never presented as shipped/stable."
      }
      instanceOf lakehouse.queryEngine
      instanceOf lakehouse.governance.pdp   // embedded Cedar decision
      instanceOf lakehouse.governance.pep   // in-plan enforcement (RLS/CM)
    }

    // mangrove — the catalog service: catalog + resource PIP + PA (vending).
    mangrove = service "mangrove" {
      #built
      description "The Unity Catalog server (unitycatalog-rs). Governs securables, serves resource facts, and vends short-lived scoped credentials after an authorize check. Its Delta API can feed Lakekeeper for Iceberg-REST interop."
      link https://github.com/open-lakehouse/mangrove
      metadata {
        sourceRepo "open-lakehouse/mangrove"
        projectName "unitycatalog-rs"
      }
      instanceOf lakehouse.catalog
      instanceOf lakehouse.governance.pip   // authoritative resource.* PIP
      instanceOf lakehouse.governance.pa    // authorize-then-vend
    }

    // headwaters — the lineage service (also a dynamic resource PIP).
    headwaters = service "headwaters" {
      #built
      description "OpenLineage on DataFusion: captures column-level lineage at planning time and ingests events into a queryable store. A dynamic (taint) PIP."
      link https://github.com/open-lakehouse/headwaters
      metadata { sourceRepo "open-lakehouse/headwaters" }
      instanceOf lakehouse.lineage
      instanceOf lakehouse.governance.pip   // lineage-derived facts
    }

    // The OCI Cedar bundle — today's PAP (policy artifact; fast-push is designed).
    cedarOci = service "cedar-oci bundle" {
      #built
      description "The Cedar policy set + schema published as an OCI bundle — today's policy administration artifact. Versioned fast-push with a freshness SLA is designed, not built."
      metadata { sourceRepo "open-lakehouse/breakwater (olai-cedar-oci)" }
      instanceOf lakehouse.governance.pap
    }

    // Object storage + relational store backing the stack.
    seaweedfs = datastore "SeaweedFS / Azurite" {
      #built
      description "S3-compatible object storage where table files are written (SeaweedFS locally; Azurite for the Azure provider)."
      metadata { sourceRepo "open-lakehouse/trestle (local-stack)" }
      instanceOf lakehouse.objectStorage
    }

    postgres = datastore "Postgres" {
      #built
      description "Relational store backing the catalog and lineage services."
    }

    // --- Deployment-specific edges: the gateway routes to every backend ----
    // (This is the "one unified surface": every backend behind one endpoint.)
    envoy -[routes]-> hydrofoil "Flight SQL / ConnectRPC"
    envoy -[routes]-> mangrove "UC REST (/api/2.1/unity-catalog)"
    envoy -[routes]-> headwaters "lineage read API"
    envoy -[routes]-> seaweedfs "object-store listener"
  }

  // =========================================================================
  // 2. external-engine (credential vending) — the FGAC-bypass topology
  // =========================================================================
  environment externalEngine {
    #untrusted

    extMangrove = service "mangrove" {
      #built
      description "The catalog vends a short-lived scoped credential to an external engine after a coarse authorize check."
      link https://github.com/open-lakehouse/mangrove
      metadata { sourceRepo "open-lakehouse/mangrove" }
      instanceOf lakehouse.catalog
      instanceOf lakehouse.governance.pa
    }

    extEngine = service "Spark / Trino / notebook" {
      #built
      description "An external, untrusted engine. Receives a vended credential and reads raw files directly — it enforces only coarse access; row filters and column masks are NOT applied."
      instanceOf sparkTrino
      instanceOf lakehouse.governance.pep   // coarse-only PEP
    }

    extStore = datastore "Object storage" {
      #built
      instanceOf lakehouse.objectStorage
    }

    // The bypass, shown explicitly: coarse vend, then raw read.
    extMangrove -[vends]-> extEngine "vends scoped credential (coarse gate only)"
    extEngine -[reads]-> extStore "reads raw files — FGAC BYPASSED"

    // The designed mitigation: catalog refuses to vend a raw credential for a
    // governed table, forcing the query through the enforcing engine.
    extMangrove -[flows]-> extEngine "non-vendable-governed-table guard" {
      #designed
    }
  }

  // =========================================================================
  // 3. browser-wasm (client-side) — untrusted browser, signed-URL/proxy
  // =========================================================================
  environment browserWasm {
    #untrusted #prototype

    axon = browser "axon (WASM workbench)" {
      #prototype
      description "A client-side WASM query engine in the browser. Reads through provider contracts; aligns to a signed-URL / byte-proxy posture — no raw cloud secrets are shipped to the browser."
      link https://github.com/open-lakehouse/axon
      metadata { sourceRepo "open-lakehouse/axon" }
      instanceOf lakehouse.queryEngine
    }

    proxyMangrove = service "mangrove (proxy)" {
      #prototype
      description "The catalog issues signed URLs / proxies bytes to the browser instead of vending raw credentials."
      metadata { sourceRepo "open-lakehouse/mangrove" }
      instanceOf lakehouse.catalog
    }

    proxyStore = datastore "Object storage" {
      instanceOf lakehouse.objectStorage
    }

    axon -[flows]-> proxyMangrove "requests signed URL (same-origin session)"
    proxyMangrove -[reads]-> proxyStore "signed URL / byte proxy"
    axon -[reads]-> proxyStore "reads via signed URL (no raw secrets)" {
      #prototype
    }
  }
}
