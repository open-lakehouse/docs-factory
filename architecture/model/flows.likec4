views {

  dynamic view credentialVending {
    title "Governance / Credential Vending"

    description "
      The catalog issues a short-lived, scoped storage credential at table-resolution time;
      the query engine reads object storage with it (no long-lived keys).
    "

    practitioner -> lakehouse.queryEngine "query table" {
      notes "
        A query is issued by a client to the query engine.
        The caller identity travels with the request.
      "
    }

    lakehouse.queryEngine -> lakehouse.catalog "resolve table" {
      notes "
        The query engine asks the catalog to resolve the table name into
        a concrete storage location, the table schema and metadata, as well
        as a credential to access the storage location.
      "
    }

    lakehouse.catalog -> lakehouse.queryEngine "scoped, short-lived credential"
    lakehouse.queryEngine -> lakehouse.objectStorage "read data files"
    lakehouse.queryEngine -> practitioner "results"
  }
}
