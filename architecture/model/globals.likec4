// Global predicate groups shared across views.
//
// Maturity coloring (#designed / #prototype -> amber) is on those tags in
// specification.likec4 and applies across view types. Incomplete realization
// of built work uses #partial on realizes edges.

global {
  // Reusable predicate: the reference lakehouse and its capabilities only.
  predicateGroup lakehouseOnly {
    include lakehouse, lakehouse.*
  }
}
