// LOGICAL LAYER (abstract) — the reference open lakehouse.
//
// Technology-agnostic capabilities and the external OSS they assemble on, plus
// the people who use the lakehouse. NO service/repo/technology names appear here
// — those live only in the deployment layer. The governance capability's zero-
// trust roles live in governance.likec4; cross-capability relationships live in
// relationships.likec4.

model {

  // --- People --------------------------------------------------------------

  practitioner = person "Data practitioner" {
    description "Queries and governs data over open table formats — the human consumer of the lakehouse."
  }

  platformEngineer = person "Platform engineer" {
    description "Builds and operates the lakehouse: the services, their health, and smooth operation of the platform."
  }

  agent = person "AI agent" {
    description "Consumes the lakehouse through agent-optimized CLIs and MCP surfaces."
  }

  // --- The reference open lakehouse: capabilities --------------------------

  lakehouse = capability "Open Lakehouse" {
    description "
      The reference architecture: warehouse-style governance and query over open
      table formats on object storage. Assembled from OSS foundations plus the
      connective tissue they don't ship.
    "
    link https://openlakehouse.io

    catalog = capability "Catalog" {
      summary "The metadata authority: a registry of tables, schemas, and access that every query resolves through."

      description "
        A catalog is the metadata layer that records which tables and schemas
        exist, where their data lives, and who may touch it — the authoritative
        namespace a query resolves a table name against before any bytes are read.

        In the lakehouse it also brokers access: at resolution time it issues a
        short-lived, scoped storage credential for exactly the data a query needs
        (credential vending), so raw storage keys are never handed out.
      "

      link https://www.openlakehouse.io/technologies/catalogs

      metadata { canonicalDoc "design/catalog-plane.md" }
    }

    queryEngine = capability "Query engine" {
      summary "Parses, plans, and executes queries over open table formats."
      description "
        A query engine turns a declarative query into a plan of operations and
        executes it: it parses the query, resolves the tables it references,
        optimizes an execution plan, and runs it to produce results.

        Here it is catalog-native — it resolves tables through the catalog, and
        credentials, policy enforcement, and lineage capture all attach to the
        plan at resolution / planning time rather than being bolted on after.
      "
      metadata { canonicalDoc "design/reference-architecture.md" }
    }

    tableFormat = capability "Open table format" {
      summary "A metadata layer that gives object-storage files ACID table semantics."

      description "
        An open table format is an open specification for a metadata layer over
        data files in object storage. It tracks which files make up a table plus
        their schema and snapshots, giving a plain directory of files table
        semantics — ACID transactions, schema evolution, and time travel.

        It is technology-agnostic in the model: Delta Lake and Apache Iceberg are
        peer concrete formats that realize this capability.
      "
      metadata { canonicalDoc "design/reference-architecture.md" }
    }

    objectStorage = capability "Object storage" {
      summary "Stores data as flat objects (blobs) addressed by key, not as a file hierarchy."
      description "
        Object storage manages data as discrete objects (blobs) in a flat
        namespace addressed by key, rather than as a file hierarchy or fixed
        blocks. It scales cheaply and horizontally, which is why it is the byte
        container the lakehouse writes table data files into.

        It sits beneath the table format: object storage holds the bytes; the
        table format is what makes those bytes a governed, transactional table.
      "
      metadata { canonicalDoc "design/reference-architecture.md" }
    }

    lineage = capability "Lineage" {
      summary "Records where data came from and where it flows, down to the column."
      description "
        Data lineage traces the origin and movement of data through the system —
        which inputs produced which outputs, dataset- and column-level.

        Here it is captured at query planning time, so provenance is derived from
        the plan the engine is about to run rather than reconstructed after.
      "
      metadata { canonicalDoc "design/lineage-plane.md" }
    }

    // Governance is a first-class capability; its zero-trust roles (PAP / PDP /
    // PEP / PIP / PA) are declared in governance.likec4 via `extend`.
    governance = capability "Governance" {
      summary "Decides who may access what, and enforces it (row filters, column masks)."
      description "
        Governance answers 'can this principal do this here?' and, when allowed,
        governs what they see — enforcing row filters and column masks.

        It is a cross-cutting zero-trust decomposition (PAP / PDP / PEP / PIP /
        PA) whose points are realized by different services per deployment.
      "
      metadata { canonicalDoc "design/governance.md" }
    }

    mlLifecycle = capability "ML lifecycle" {
      summary "Tracks experiments, versions models, and governs their promotion to production."
      description "
        The ML-lifecycle capability manages machine-learning artifacts over time:
        experiment tracking, a model registry with versions and stages, and the
        path from a trained model to a governed, deployable one.

        It sits alongside the query/governance capabilities: models are data
        assets too, catalogued and governed like tables rather than living in a
        separate, ungoverned silo.
      "
      metadata { canonicalDoc "design/reference-architecture.md" }
    }
  }

  // --- OSS foundations & concrete formats it assembles on ------------------
  // External technologies that realize a capability. Each is co-located with its
  // `realizes` edge to the capability it realizes (not to the lakehouse as a
  // whole). Omnigent is the exception: agent tooling, so it carries no edge.
  //
  // Icons are the official project marks (LF AI & Data / Apache), referenced by
  // a commit-pinned raw URL. A remote URL (not a local file) is deliberate: the
  // committed, portable dist/model.json is browser-consumed, and LikeC4's JSON
  // export serializes a local icon as an absolute file:// path (machine-specific,
  // unloadable in a browser). The pin guards against upstream artwork moving.

  unityCatalog = foundation "Unity Catalog" {
    description "Open source catalog for data & AI — governs tables, files, functions, and models across engines."
    link https://www.unitycatalog.io
    style {
      icon https://raw.githubusercontent.com/lfai/artwork/13457311161fab6c20b76af3f20d37db4b7526ef/projects/unity_catalog/icon/color/SVG/uc_icon_color.svg
    }
  }
  unityCatalog -[realizes]-> lakehouse.catalog "realizes the catalog capability"

  deltaLake = foundation "Delta Lake" {
    description "Open table format bringing ACID transactions, schema evolution, and time travel to object storage."
    link https://delta.io
    style {
      icon https://raw.githubusercontent.com/lfai/artwork/22ca59a23e3badad811a138fd6a3e651ab19a41b/projects/DeltaLake/icon/DeltaLake-icon-color.svg
    }
  }
  deltaLake -[realizes]-> lakehouse.tableFormat "realizes the table-format capability"

  iceberg = foundation "Apache Iceberg" {
    description "Open table format for huge analytic datasets, with hidden partitioning and snapshot isolation."
    link https://iceberg.apache.org
    style {
      icon https://raw.githubusercontent.com/apache/iceberg/e2b56daf35724700a9b57dbeee5fe23f99c592c4/site/docs/assets/images/iceberg-logo-icon.png
    }
  }
  iceberg -[realizes]-> lakehouse.tableFormat "realizes the table-format capability"

  datafusion = foundation "Apache DataFusion" {
    description "Extensible, high-performance query engine in Rust using Apache Arrow."
    link https://datafusion.apache.org
    style {
      icon https://raw.githubusercontent.com/apache/datafusion/1b924ff2aa0543b48a4bb472f7e86b109a1c0eac/docs/logos/standalone_logo/logo_original.svg
    }
  }
  datafusion -[realizes]-> lakehouse.queryEngine "realizes the query-engine capability"

  apacheSpark = foundation "Apache Spark" {
    description "Unified analytics engine for large-scale data processing."
    link https://spark.apache.org
    style {
      // Spark ships no square icon mark — this is the official (wide) wordmark.
      icon https://raw.githubusercontent.com/apache/spark-website/8eb764260f5308960c69c212c642cd19ededf3ed/images/spark-logo.png
    }
  }
  apacheSpark -[realizes]-> lakehouse.queryEngine "realizes the query-engine capability"

  lakekeeper = foundation "Lakekeeper" {
    description "Apache-licensed, Rust-native implementation of the Apache Iceberg REST Catalog specification."
    link https://lakekeeper.io
    style {
      icon https://raw.githubusercontent.com/lakekeeper/lakekeeper/22ad0ba6994131bc3943d7778436127203fdba82/site/docs/assets/logos/LAKEKEEPER_IMAGE.svg
    }
  }
  lakekeeper -[realizes]-> lakehouse.catalog "realizes the catalog capability"

  mlflow = foundation "MLflow" {
    description "Open source platform for the ML lifecycle: experiment tracking, model registry, and deployment."
    link https://mlflow.org
    style {
      icon https://raw.githubusercontent.com/mlflow/mlflow/352aff6bcb3e4eabcc29d8ea3a8b7059e7084862/assets/icon.svg
    }
  }
  mlflow -[realizes]-> lakehouse.mlLifecycle "realizes the ML-lifecycle capability"

  // Omnigent — Databricks' Apache-2.0 AI-agent meta-harness. Deliberately has NO
  // `realizes` edge: it is agent tooling, not a lakehouse capability.
  omnigent = foundation "Omnigent" {
    description "Open source meta-harness for AI agents: composes, governs, and shares sessions across multiple agent harnesses (Claude Code, Codex, etc.). Apache 2.0, from Databricks."
    link https://omnigent.ai
    style {
      icon https://raw.githubusercontent.com/omnigent-ai/omnigent/99e25f6de1ae8c9f31f2a70efbfc09d95fd8884c/editors/vscode/media/omnigent-icon.svg
    }
  }
}
