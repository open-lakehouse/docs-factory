// LOGICAL LAYER (abstract) — the reference open lakehouse.
//
// Technology-agnostic capabilities and the external OSS they assemble on, plus
// the people who use the lakehouse. NO service/repo/technology names appear here
// — those live only in the deployment layer. The governance capability's zero-
// trust roles live in governance.likec4; cross-capability relationships live in
// relationships.likec4.

model {

  // --- People --------------------------------------------------------------

  practitioner = person "Data practitioner" {
    description "Queries and governs data over open table formats — the human consumer of the lakehouse."
  }

  platformEngineer = person "Platform engineer" {
    description "Builds and operates the lakehouse: the services, their health, and smooth operation of the platform."
  }

  agent = person "AI agent" {
    description "Consumes the lakehouse through agent-optimized CLIs and MCP surfaces."
  }

  // --- The reference open lakehouse: capabilities --------------------------

  lakehouse = capability "Open Lakehouse" {
    description "
      The reference architecture: warehouse-style governance and query over open
      table formats on object storage. Assembled from OSS foundations plus the
      connective tissue they don't ship.
    "
    link https://openlakehouse.io

    catalog = capability "Catalog" {
      summary "The metadata authority: a registry of tables, schemas, and access that every query resolves through."

      description "
        A catalog is the metadata layer that records which tables and schemas
        exist, where their data lives, and who may touch it — the authoritative
        namespace a query resolves a table name against before any bytes are read.

        In the lakehouse it also brokers access: at resolution time it issues a
        short-lived, scoped storage credential for exactly the data a query needs
        (credential vending), so raw storage keys are never handed out.
      "

      link https://www.openlakehouse.io/technologies/catalogs

      metadata { canonicalDoc "design/catalog-plane.md" }
    }

    queryEngine = capability "Query engine" {
      summary "Parses, plans, and executes queries over open table formats."
      description "
        A query engine turns a declarative query into a plan of operations and
        executes it: it parses the query, resolves the tables it references,
        optimizes an execution plan, and runs it to produce results.

        Here it is catalog-native — it resolves tables through the catalog, and
        credentials, policy enforcement, and lineage capture all attach to the
        plan at resolution / planning time rather than being bolted on after.
      "
      metadata { canonicalDoc "design/reference-architecture.md" }
    }

    tableFormat = capability "Open table format" {
      summary "A metadata layer that gives object-storage files ACID table semantics."

      description "
        An open table format is an open specification for a metadata layer over
        data files in object storage. It tracks which files make up a table plus
        their schema and snapshots, giving a plain directory of files table
        semantics — ACID transactions, schema evolution, and time travel.

        It is technology-agnostic in the model: Delta Lake and Apache Iceberg are
        peer concrete formats that realize this capability.
      "
      metadata { canonicalDoc "design/reference-architecture.md" }
    }

    objectStorage = capability "Object storage" {
      summary "Stores data as flat objects (blobs) addressed by key, not as a file hierarchy."
      description "
        Object storage manages data as discrete objects (blobs) in a flat
        namespace addressed by key, rather than as a file hierarchy or fixed
        blocks. It scales cheaply and horizontally, which is why it is the byte
        container the lakehouse writes table data files into.

        It sits beneath the table format: object storage holds the bytes; the
        table format is what makes those bytes a governed, transactional table.
      "
      metadata { canonicalDoc "design/reference-architecture.md" }
    }

    lineage = capability "Lineage" {
      summary "Records where data came from and where it flows, down to the column."
      description "
        Data lineage traces the origin and movement of data through the system —
        which inputs produced which outputs, dataset- and column-level.

        Here it is captured at query planning time, so provenance is derived from
        the plan the engine is about to run rather than reconstructed after.
      "
      metadata { canonicalDoc "design/lineage-plane.md" }
    }

    // Governance is a first-class capability; its zero-trust roles (PAP / PDP /
    // PEP / PIP / PA) are declared in governance.likec4 via `extend`.
    governance = capability "Governance" {
      summary "Decides who may access what, and enforces it (row filters, column masks)."
      description "
        Governance answers 'can this principal do this here?' and, when allowed,
        governs what they see — enforcing row filters and column masks.

        It is a cross-cutting zero-trust decomposition (PAP / PDP / PEP / PIP /
        PA) whose points are realized by different services per deployment.
      "
      metadata { canonicalDoc "design/governance.md" }
    }
  }
}
