// LOGICAL LAYER (abstract) — the reference open lakehouse.
//
// Technology-agnostic capabilities and the external OSS they assemble on, plus
// the people who use the lakehouse. NO repo/service/infra names appear here —
// those live only in the deployment layer. The governance capability's internal
// zero-trust roles live in governance.likec4; cross-capability relationships
// live in relationships.likec4.

model {

  // --- People --------------------------------------------------------------

  practitioner = person "Data practitioner" {
    description "Queries and governs data over open table formats — the human consumer of the lakehouse."
  }

  platformEngineer = person "Platform engineer" {
    description "Builds and operates the lakehouse services; the primary audience for this model."
  }

  agent = person "AI agent" {
    description "Consumes the lakehouse through agent-optimized CLIs and MCP surfaces. The 'and AI' half of open-lakehouse-and-ai."
  }

  // --- The reference open lakehouse: capabilities --------------------------

  lakehouse = capability "Open Lakehouse" {
    description "
      The reference architecture: warehouse-style governance and query over open table formats on object storage.
      Assembled from OSS foundations plus the connective tissue they don't ship.
    "
    link https://openlakehouse.io
    link https://github.com/open-lakehouse

    catalog = capability "Catalog" {
      description "Governs tables, schemas, and credentials. The surface every query resolves through; issues short-lived scoped storage credentials at resolution time (credential vending)."
      metadata { canonicalDoc "design/catalog-plane.md" }
    }

    queryEngine = capability "Query engine" {
      description "Resolves tables through the catalog and executes over open table formats. Catalog-native: credentials, policy, and lineage attach at resolution/planning time."
      metadata { canonicalDoc "design/reference-architecture.md" }
    }

    tableFormat = capability "Open table format" {
      description "Gives raw object-storage bytes table semantics — ACID transactions, schema, and snapshots. The technology-agnostic 'open table format' layer; Delta and Iceberg are peer concrete formats that realize it."
      metadata { canonicalDoc "design/reference-architecture.md" }
    }

    objectStorage = capability "Object storage" {
      description "The byte container where table data files are written. Beneath the table format — the format is what makes these bytes a governed, transactional table."
      metadata { canonicalDoc "design/reference-architecture.md" }
    }

    lineage = capability "Lineage" {
      description "Captures dataset- and column-level provenance (OpenLineage) at query planning time — 'where did this data come from, and where does it flow'."
      metadata { canonicalDoc "design/lineage-plane.md" }
    }

    // Governance is a first-class capability; its zero-trust roles (PAP/PDP/
    // PEP/PIP/PA) are declared in governance.likec4 via `extend`.
    governance = capability "Governance" {
      description "Decides 'can this principal do this here?' and, when allowed, governs what they see (row filters, column masks). A cross-cutting zero-trust decomposition (PAP / PDP / PEP / PIP) whose points are realized by different services per deployment."
      metadata { canonicalDoc "design/governance.md" }
    }
  }

  // --- External OSS foundations & concrete formats -------------------------

  datafusion = foundation "Apache DataFusion" {
    description "The shared query/compute core the query engine is built on. Policy and lineage plug in via its extension points."
    technology "Rust query engine"
    link https://datafusion.apache.org
  }

  // Delta and Iceberg are PEER open table formats realizing `tableFormat`.
  delta = foundation "Delta Lake" {
    description "An open table format (via delta-rs / delta-kernel-rs). Realizes the tableFormat capability."
    technology "Delta Lake"
    link https://delta.io
  }

  iceberg = foundation "Apache Iceberg" {
    description "An open table format. Realizes the tableFormat capability; reached in the estate via Iceberg-REST catalogs (e.g. Lakekeeper)."
    technology "Apache Iceberg"
    link https://iceberg.apache.org
  }

  cedar = foundation "AWS Cedar" {
    description "The policy language and decision engine behind the governance PDP."
    technology "Cedar"
    link https://www.cedarpolicy.com
  }

  openlineage = foundation "OpenLineage" {
    description "The lineage event standard the lineage capability emits and ingests. Marquez is the reference server it's inspired by."
    technology "OpenLineage / Marquez"
    link https://openlineage.io
  }

  unitycatalog = foundation "Unity Catalog OSS" {
    description "The governance API surface the catalog builds and integrates with — and explores ahead of — rather than competing with the official Java implementation."
    technology "Unity Catalog"
    link https://www.unitycatalog.io
  }

  lakekeeper = foundation "Lakekeeper" {
    description "An Iceberg-REST catalog. The catalog's Delta API can feed it (feasibility-stage interop) so Iceberg-REST consumers see the same tables."
    technology "Iceberg-REST catalog"
    link https://github.com/lakekeeper/lakekeeper
  }

  // --- External untrusted engines (deployment consumers) -------------------

  sparkTrino = externalEngine "Spark / Trino / notebook" {
    description "An external query engine that can receive a vended scoped storage credential and read raw files. Enforces only coarse access — FGAC (row filters / column masks) is bypassed when it reads directly."
    metadata { canonicalDoc "design/deployments.md" }
  }
}
