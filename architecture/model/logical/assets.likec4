// LOGICAL LAYER — governed asset kinds (the "securable" subjects).
//
// The subject axis of the model (see ADR-0006). Capabilities are the VERBS the
// lakehouse performs; asset kinds are the NOUNS it manages along the data & AI
// value chain. Each kind is technology-agnostic and TYPE-LEVEL — a specific
// table / model is an instance and lives in the runtime world, never here.
//
// Two edges give the axis its meaning:
//   requires  — an asset kind requires a capability to be managed / materialized.
//               Every kind requires the `catalog` (that is what makes it a
//               governed securable); domain capabilities are what materialize it.
//   governs   — a catalog SPECIFICATION governs a set of asset kinds. This is
//               where breadth shows: Unity Catalog governs the full data & AI
//               set; the Iceberg REST catalog governs namespaces + tables. The
//               contrast is a structural fact of the model, not prose.
//
// "Securable" is Unity Catalog's name for an asset kind; the vendor-neutral term
// `asset` is used in the logical layer (glossary records the mapping).

model {
  extend lakehouse {

    // schema is the CONTAINER kind — the namespace other securables live in.
    schema = asset "Schema / namespace" {
      summary "The namespace container other asset kinds are organized under."
      description "
        A schema (namespace) is the container securable: the addressable namespace
        that tables, volumes, functions, models, and skills are organized and
        governed within. Grants and lineage attach at this level as well as at the
        leaf asset.
      "
      metadata { canonicalDoc "design/asset-kinds.md" }
    }

    table = asset "Table" {
      summary "The classic tabular securable — rows and columns with ACID semantics."
      description "
        A table is the tabular asset kind: schema'd rows and columns with ACID
        table semantics. It is the one asset kind every catalog handles, and the
        only kind a table-format-centric catalog handles.
      "
      metadata { canonicalDoc "design/asset-kinds.md" }
    }

    volume = asset "Volume" {
      summary "Governed non-tabular files — a catalogued path in object storage."
      description "
        A volume is the non-tabular asset kind: a governed location of arbitrary
        files (images, PDFs, checkpoints) in object storage, catalogued and
        access-controlled like a table rather than left as ungoverned raw storage.
      "
      metadata { canonicalDoc "design/asset-kinds.md" }
    }

    registeredFunction = asset "Function" {
      summary "A governed, reusable unit of computation registered in the catalog."
      description "
        A function is the executable asset kind: a registered, reusable unit of
        computation (a UDF or routine) that the query engine can resolve and run,
        governed and versioned through the catalog like data.
      "
      metadata { canonicalDoc "design/asset-kinds.md" }
    }

    mlModel = asset "Model" {
      summary "A governed ML model — versions, stages, and lineage catalogued like data."
      description "
        A model is the ML asset kind: a trained machine-learning artifact with
        versions and lifecycle stages, tracked and governed as a catalogued asset
        rather than living in a separate, ungoverned registry.
      "
      metadata { canonicalDoc "design/asset-kinds.md" }
    }

    agentSkill = asset "Agent skill" {
      summary "An emerging asset kind: a shareable, governed capability for AI agents."
      description "
        An agent skill is an emerging asset kind on the data & AI value chain: a
        packaged, shareable capability an AI agent can discover and invoke,
        governed and distributed through the catalog / Open Sharing surface. A
        flagship example of a catalog augmenting beyond the tabular set.
      "
      metadata { canonicalDoc "design/asset-kinds.md" }
    }

    // --- requires: what a platform must do to manage each kind --------------
    // Every kind requires the catalog to be a governed securable at all; domain
    // capabilities are what actually materialize each kind.
    schema             -[requires]-> catalog       "governed / namespaced by"
    table              -[requires]-> catalog       "governed / resolved through"
    table              -[requires]-> tableFormat   "materialized as an open table format"
    table              -[requires]-> queryEngine   "read + written by"
    volume             -[requires]-> catalog       "governed / resolved through"
    volume             -[requires]-> objectStorage "materialized as files in"
    registeredFunction -[requires]-> catalog       "governed / resolved through"
    registeredFunction -[requires]-> queryEngine   "executed by"
    mlModel            -[requires]-> catalog       "governed / resolved through"
    mlModel            -[requires]-> modelTracking "versioned + promoted by"
    // agent skills are governed by the catalog and distributed via the sharing
    // capability (Open Sharing) — the estate's flagship "new resource kind".
    agentSkill         -[requires]-> catalog       "governed / resolved through"
    agentSkill         -[requires]-> sharing       "distributed as a shareable resource via"
  }

  // --- governs: which catalog spec covers which asset kinds (breadth) --------
  // Unity Catalog governs the full data & AI set — the differentiator.
  ucSpec -[governs]-> lakehouse.schema             "governs"
  ucSpec -[governs]-> lakehouse.table              "governs"
  ucSpec -[governs]-> lakehouse.volume             "governs"
  ucSpec -[governs]-> lakehouse.registeredFunction "governs"
  ucSpec -[governs]-> lakehouse.mlModel            "governs"
  ucSpec -[governs]-> lakehouse.agentSkill         "governs"

  // The Iceberg REST catalog is table-centric: namespaces + tables (+ views).
  icebergRestSpec -[governs]-> lakehouse.schema "governs namespaces"
  icebergRestSpec -[governs]-> lakehouse.table  "governs"
}
