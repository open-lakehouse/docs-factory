// LOGICAL LAYER (concrete technology) — Libraries that implement a table
// format.

model {

  deltaRs = implementation "delta-rs" {
    #library #public

    description "Native Rust implementation of the Delta protocol with Python bindings."

    link https://delta-io.github.io/delta-rs/

    metadata {
      sourceRepo "delta-io/delta-rs"
      pypi "deltalake"
      crate "deltalake"
      license "Apache-2.0"
      language "Rust"
    }
  }
  deltaRs -[implements]-> deltaSpec
  deltaRs -[realizes]-> lakehouse.tableFormat
  deltaRs -[consumes]-> unityCatalogSpec "resolves tables via"
  deltaRs -[consumes]-> s3Spec "reads/writes data files via"
  deltaRs -[builtOn]-> objectStore
  deltaRs -[operatesOn]-> lakehouse.table "reads and changes"

  pyIceberg = implementation "PyIceberg" {
    #library #public

    description "Python implementation of Apache Iceberg with REST catalog and table APIs."
    link https://py.iceberg.apache.org

    metadata {
      sourceRepo "apache/iceberg-python"
      pypi "pyiceberg"
      license "Apache-2.0"
      language "Python"
    }
  }
  pyIceberg -[implements]-> icebergSpec
  pyIceberg -[realizes]-> lakehouse.tableFormat
  pyIceberg -[consumes]-> icebergRestSpec "uses the REST catalog"
  pyIceberg -[operatesOn]-> lakehouse.namespace "creates and lists"
  pyIceberg -[operatesOn]-> lakehouse.table "creates and changes"

  icebergRust = implementation "iceberg-rust" {
    #library #public

    description "Rust implementation of Apache Iceberg with REST catalog and table APIs, and a DataFusion integration."
    link https://rust.iceberg.apache.org

    metadata {
      sourceRepo "apache/iceberg-rust"
      crate "iceberg"
      license "Apache-2.0"
      language "Rust"
    }
  }
  icebergRust -[implements]-> icebergSpec
  icebergRust -[realizes]-> lakehouse.tableFormat
  icebergRust -[consumes]-> icebergRestSpec "uses the REST catalog"
  icebergRust -[consumes]-> s3Spec "reads/writes data files via"
  icebergRust -[operatesOn]-> lakehouse.namespace "creates and lists"
  icebergRust -[operatesOn]-> lakehouse.table "creates and changes"

}
