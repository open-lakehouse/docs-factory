// LOGICAL LAYER — cross-capability relationships of the reference lakehouse.
//
// The core chain: queryEngine -> catalog -> tableFormat -> fileFormat ->
// objectStorage. The governance, lineage, and observability concerns attach
// at resolution / planning time; their edges live in concerns.likec4.
// Specifications specify the capabilities and implementations realize them
// (co-located in technology-catalog.likec4).

model {
  extend lakehouse {

    // The read path: a query engine resolves names in the catalog, the catalog
    // points at a table format, the table format lays out a file format, and
    // object storage holds the bytes.
    queryEngine -[dependsOn]-> catalog "resolves table names and credentials through"
    catalog -[dependsOn]-> tableFormat "registers tables whose layout is"
    tableFormat -[dependsOn]-> fileFormat "stores data files in"
    fileFormat -[dependsOn]-> objectStorage "writes files to"

    // Orchestration drives the compute: it schedules pipelines onto the query
    // engine. Its run status flows to observability (concerns.likec4).
    orchestration -[flows]-> queryEngine "schedules + triggers pipelines that run on"

    // A notebook session submits work to the engine; the notebook itself is a
    // file the catalog governs in a volume.
    interactiveDevelopment -[flows]-> queryEngine "runs session queries on"
    interactiveDevelopment -[dependsOn]-> volume "persists notebooks as files in"

    // Credential vending: the catalog mints scoped credentials through the
    // issuer, and object storage enforces the scope they carry.
    catalog -[dependsOn]-> credentialIssuer "mints scoped storage credentials through"
    credentialIssuer -[flows]-> objectStorage "issues credentials honored by"
  }

  // --- Specifications & implementations ------------------------------------
  // `specifies` / `implements` / `realizes` edges are co-located with each
  // specification / implementation element in technology-catalog.likec4, so
  // nothing lives here.

  // --- People --------------------------------------------------------------

  practitioner -[flows]-> lakehouse.queryEngine "queries + governs data"
  practitioner -[flows]-> lakehouse.interactiveDevelopment "explores data + builds logic in"
  // person -> the estate BOUNDARY. `lakehouse` is the C4 SoftwareSystem /
  // Backstage System-Domain analog for the whole estate (ADR-0006).
  platformEngineer -[flows]-> lakehouse "builds + operates"
}
