// LOGICAL LAYER — cross-capability relationships of the reference lakehouse.
//
// The core chain: queryEngine -> catalog -> tableFormat -> fileFormat ->
// objectStorage, with governance, lineage, and observability attaching at
// resolution / planning time. Specifications specify the capabilities and
// implementations realize them (co-located in technology-catalog.likec4).
// Deployment-specific edges (per-topology credential vending) live in
// deployment/deployments.likec4.

model {
  extend lakehouse {
    // Governance + lineage + observability attach to the query engine at
    // planning / execution time.
    queryEngine -[flows]-> lineage "emits column-level lineage (planning-time)"
    queryEngine -[flows]-> observability "emits traces + metrics"

    // Orchestration drives the compute: it schedules pipelines onto the query
    // engine and emits run status to observability.
    orchestration -[flows]-> queryEngine "schedules + triggers pipelines that run on"
    orchestration -[flows]-> observability "emits run status + metrics"

    // The catalog is the authoritative resource PIP and hosts the PA (vending).
    catalog -[flows]-> governance.pip "serves resource facts (identity, tags, locations)"
  }

  // --- Specifications & implementations ------------------------------------
  // `specifies` / `implements` / `realizes` edges are co-located with each
  // specification / implementation element in technology-catalog.likec4, so
  // nothing lives here.

  // --- People --------------------------------------------------------------

  practitioner -[flows]-> lakehouse.queryEngine "queries + governs data"
  // person -> the estate BOUNDARY. `lakehouse` is the C4 SoftwareSystem /
  // Backstage System-Domain analog for the whole estate (ADR-0006).
  platformEngineer -[flows]-> lakehouse "builds + operates"
}
