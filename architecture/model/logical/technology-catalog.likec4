// LOGICAL LAYER (concrete technology)

model {

  // Table-format specifications ---------------------------------------------
  deltaSpec = openSpecification "Delta Lake" {
    description "
      Open table-format specification: ACID transactions,
      schema evolution, and time travel over object storage.
    "
    link https://delta.io

    style {
      icon https://raw.githubusercontent.com/lfai/artwork/22ca59a23e3badad811a138fd6a3e651ab19a41b/projects/DeltaLake/icon/DeltaLake-icon-color.svg
    }
  }
  deltaSpec -[specifies]-> lakehouse.tableFormat {}

  icebergSpec = openSpecification "Apache Iceberg" {
    description "
      Open table-format specification for huge analytic datasets,
      with hidden partitioning and snapshot isolation.
    "

    link https://iceberg.apache.org

    style {
      icon https://raw.githubusercontent.com/apache/iceberg/e2b56daf35724700a9b57dbeee5fe23f99c592c4/site/docs/assets/images/iceberg-logo-icon.png
    }
  }
  icebergSpec -[specifies]-> lakehouse.tableFormat {}

  ucSpec = openSpecification "Unity Catalog" {
    description "
      Open catalog specification for data & AI:
      a catalog governing tables, files, functions, and models across engines.
    "

    link https://www.unitycatalog.io

    style {
      icon https://raw.githubusercontent.com/lfai/artwork/13457311161fab6c20b76af3f20d37db4b7526ef/projects/unity_catalog/icon/color/SVG/uc_icon_color.svg
    }
  }
  ucSpec -[specifies]-> lakehouse.catalog "specifies the catalog capability"

  icebergRestSpec = openSpecification "Iceberg REST Catalog" {
    description "
      Specification for a REST based Iceberg catalog
    "

    link https://iceberg.apache.org/concepts/catalog/
  }
  icebergRestSpec -[specifies]-> lakehouse.catalog "specifies the catalog capability"

  openSharingSpec = openSpecification "Open Sharing" {
    description "Open profile of the Delta Sharing protocol."
    link https://delta.io/sharing/
  }
  openSharingSpec -[specifies]-> lakehouse.sharing "specifies the sharing capability"

  parquetSpec = openSpecification "Apache Parquet" {
    description "
      Open columnar file format: column-wise storage with compression and
      statistics, the data-file layer most table formats are written in.
    "

    link https://parquet.apache.org
  }
  parquetSpec -[specifies]-> lakehouse.fileFormat "specifies the file-format capability"

  s3Api = openSpecification "S3 API" {
    description "The de-facto object-storage interface. Not a formal standard, but the contract most stores implement."
    link https://docs.aws.amazon.com/AmazonS3/latest/API/Welcome.html
  }
  s3Api -[specifies]-> lakehouse.objectStorage "specifies the object-storage capability"

  // Query APIs: how a client reaches a served engine (a "warehouse" is a
  // query engine behind one of these). Only protocols something here implements.
  sparkConnectSpec = openSpecification "Spark Connect" {
    description "Client-server protocol for Apache Spark: thin clients send unresolved plans over gRPC to a remote Spark server."
    link https://spark.apache.org/docs/latest/spark-connect-overview.html
  }
  sparkConnectSpec -[specifies]-> lakehouse.queryEngine "specifies remote query submission"

  flightSqlSpec = openSpecification "Arrow Flight SQL" {
    description "Protocol for running SQL against a remote engine over Arrow Flight, returning Arrow record batches."
    link https://arrow.apache.org/docs/format/FlightSql.html
  }
  flightSqlSpec -[specifies]-> lakehouse.queryEngine "specifies remote SQL"

  openCypherSpec = openSpecification "openCypher" {
    description "Open specification of the Cypher graph query language."
    link https://opencypher.org
  }
  openCypherSpec -[specifies]-> lakehouse.queryEngine "specifies graph queries"

  azureBlobApi = openSpecification "Azure Blob Storage API" {
    description "The REST interface to Azure Blob Storage, also served by local emulators."
    link https://learn.microsoft.com/en-us/rest/api/storageservices/blob-service-rest-api
  }
  azureBlobApi -[specifies]-> lakehouse.objectStorage "specifies the object-storage capability"

  openLineageSpec = openSpecification "OpenLineage" {
    description "Open standard for lineage events: jobs, runs, and the datasets they read and write, down to the column."
    link https://openlineage.io
  }
  openLineageSpec -[specifies]-> lakehouse.lineage "specifies the lineage event model"

  otlpSpec = openSpecification "OpenTelemetry Protocol (OTLP)" {
    description "The OpenTelemetry wire protocol for exporting traces, metrics, and logs to a backend."
    link https://opentelemetry.io/docs/specs/otlp/
  }
  otlpSpec -[specifies]-> lakehouse.observability "specifies telemetry export"

  datafusion = implementation "Apache DataFusion" {
    #library

    description "Extensible, high-performance query engine in Rust using Apache Arrow. Embeds as a library."
    link https://datafusion.apache.org

    style {
      icon https://raw.githubusercontent.com/apache/datafusion/1b924ff2aa0543b48a4bb472f7e86b109a1c0eac/docs/logos/standalone_logo/logo_original.svg
    }
  }
  datafusion -[realizes]-> lakehouse.queryEngine "realizes the query-engine capability"
  datafusion -[consumes]-> s3Api "reads data files via"

  apacheSpark = implementation "Apache Spark" {
    #service

    description "Unified analytics engine for large-scale data processing."

    link https://spark.apache.org

    style {
      icon https://raw.githubusercontent.com/apache/spark-website/8eb764260f5308960c69c212c642cd19ededf3ed/images/spark-logo.png
    }
  }
  apacheSpark -[realizes]-> lakehouse.queryEngine "realizes the query-engine capability"
  apacheSpark -[consumes]-> icebergRestSpec "reads via"
  apacheSpark -[consumes]-> ucSpec "resolves tables via"
  apacheSpark -[implements]-> sparkConnectSpec "serves"

  deltaRs = implementation "delta-rs" {
    #library

    description "Native Rust implementation of the Delta protocol with Python bindings."

    link https://delta-io.github.io/delta-rs/
  }
  deltaRs -[implements]-> deltaSpec "implements"
  deltaRs -[consumes]-> s3Api "reads/writes data files via"

  deltaSpark = implementation "Delta Spark" {
    #service

    description "The reference Delta connector for Apache Spark (`io.delta:delta-spark`)."

    link https://docs.delta.io
  }
  deltaSpark -[implements]-> deltaSpec "implements"
  deltaSpark -[realizes]-> lakehouse.queryEngine "realizes the query-engine capability"

  duckdb = implementation "DuckDB" {
    #library

    description "In-process analytical SQL engine."

    link https://duckdb.org
  }
  duckdb -[realizes]-> lakehouse.queryEngine "realizes the query-engine capability"
  duckdb -[consumes]-> deltaSpec "reads Delta tables via"
  duckdb -[consumes]-> icebergRestSpec "reads Iceberg tables via"
  duckdb -[consumes]-> ucSpec "resolves tables via"

  polars = implementation "Polars" {
    #library

    description "Fast DataFrame library written in Rust with a Python API;"

    link https://pola.rs

    style {
      icon https://avatars.githubusercontent.com/u/83768144?s=200&v=4
    }
  }
  polars -[realizes]-> lakehouse.queryEngine "realizes the query-engine capability"
  // impl -> impl is a DEPENDENCY, not spec-consumption (`consumes` is impl -> spec). See ADR-0006.
  polars -[dependsOn]-> deltaRs "reads/writes Delta via"
  polars -[consumes]-> ucSpec "resolves tables via"

  // Catalog implementations --------------------------------------------------
  lakekeeper = implementation "Lakekeeper" {
    #service

    description "Apache-licensed, Rust-native catalog server implementing the Iceberg REST Catalog specification."

    link https://lakekeeper.io
    style {
      icon https://raw.githubusercontent.com/lakekeeper/lakekeeper/22ad0ba6994131bc3943d7778436127203fdba82/site/docs/assets/logos/LAKEKEEPER_IMAGE.svg
    }
  }
  lakekeeper -[implements]-> icebergRestSpec "implements"
  lakekeeper -[realizes]-> lakehouse.governance.authorization "table-level permissions via OpenFGA"
  lakekeeper -[realizes]-> lakehouse.governance.authentication "validates OIDC tokens" {
    #partial
  }

  unityCatalogOSS = implementation "Unity Catalog (OSS)" {
    #service
    description "The open-source reference server implementing the Unity Catalog specification."

    link https://github.com/unitycatalog/unitycatalog
    link https://unitycatalog.io

    style {
      icon https://raw.githubusercontent.com/lfai/artwork/13457311161fab6c20b76af3f20d37db4b7526ef/projects/unity_catalog/icon/color/SVG/uc_icon_color.svg
    }
  }
  unityCatalogOSS -[implements]-> ucSpec "implements"
  unityCatalogOSS -[implements]-> icebergRestSpec "serves Iceberg tables through"
  unityCatalogOSS -[realizes]-> lakehouse.governance.authorization "grants + privileges on securables"
  unityCatalogOSS -[realizes]-> lakehouse.governance.authentication "validates access tokens" {
    #partial
  }

  // Model-tracking implementation --------------------------------------------
  mlflow = implementation "MLflow" {
    #service

    description "Open source platform for the ML lifecycle: experiment tracking, model registry, and deployment."

    link https://mlflow.org

    style {
      icon https://raw.githubusercontent.com/mlflow/mlflow/352aff6bcb3e4eabcc29d8ea3a8b7059e7084862/assets/icon.svg
    }
  }
  mlflow -[realizes]-> lakehouse.modelTracking "realizes the model-tracking capability"

  // First-party query engine ------------------------------------------------
  // trustedCompute's hydrofoil is an instance of this. Fine-grained access is
  // #partial: it decides and enforces in-plan, but needs the catalog's resource
  // facts and a policy bundle to do it.
  hydrofoil = implementation "hydrofoil" {
    #service

    description "Catalog-native query engine on DataFusion, served over Arrow Flight SQL, that enforces Cedar policy in the query plan and captures lineage at planning time."
    link https://github.com/open-lakehouse/hydrofoil
  }
  hydrofoil -[realizes]-> lakehouse.queryEngine "realizes the query-engine capability"
  hydrofoil -[implements]-> flightSqlSpec "serves"
  hydrofoil -[consumes]-> ucSpec "resolves tables via"
  hydrofoil -[dependsOn]-> datafusion "built on"
  hydrofoil -[realizes]-> lakehouse.governance.authorization "coarse allow/deny gate before planning" {
    #partial
  }
  hydrofoil -[realizes]-> lakehouse.governance.fineGrainedAccess "rewrites plans with row filters + column masks" {
    #partial
  }

  // Lineage, governance, and observability implementations -----------------
  // headwaters is first-party; the technology catalog names our software too
  // (ADR-0003 amendment), and trustedCompute's headwaters is an instance of it.
  headwaters = implementation "headwaters" {
    #service

    description "Captures column-level lineage from DataFusion plans at planning time and ingests OpenLineage events into a queryable store."
    link https://github.com/open-lakehouse/headwaters
  }
  headwaters -[realizes]-> lakehouse.lineage "realizes the lineage concern"
  headwaters -[implements]-> openLineageSpec "emits + ingests"

  authelia = implementation "Authelia" {
    #service

    description "Open source authentication and authorization server that fronts web services with single sign-on and access rules."
    link https://www.authelia.com
  }
  authelia -[realizes]-> lakehouse.governance.authentication "single sign-on at the gateway"
  authelia -[realizes]-> lakehouse.governance.authorization "access rules at the gateway" {
    #partial
  }

  openPolicyAgent = implementation "Open Policy Agent" {
    #service

    description "General-purpose policy engine: evaluates policies written in Rego against a request and returns a decision."
    link https://www.openpolicyagent.org
  }
  openPolicyAgent -[realizes]-> lakehouse.governance.authorization "decides access policy" {
    #partial
  }

  jaeger = implementation "Jaeger" {
    #service

    description "Open source distributed tracing backend: collects, stores, and visualizes traces."
    link https://www.jaegertracing.io
  }
  jaeger -[realizes]-> lakehouse.observability "realizes tracing"
  jaeger -[consumes]-> otlpSpec "receives traces via"

  // Other query and notebook surfaces --------------------------------------
  puppygraph = implementation "PuppyGraph" {
    #service

    description "Graph query engine that runs graph queries over existing tables without copying them into a graph database."
    link https://www.puppygraph.com
  }
  puppygraph -[realizes]-> lakehouse.queryEngine "realizes graph queries over tables"
  puppygraph -[implements]-> openCypherSpec "serves"

  marimo = implementation "marimo" {
    #service

    description "Reactive Python notebook, stored as plain Python files."
    link https://marimo.io
  }
  marimo -[realizes]-> lakehouse.interactiveDevelopment "realizes the notebook"

  // Orchestration implementation -------------------------------------------
  rivers = implementation "Rivers" {
    #service

    description "Asset-based orchestrator for Python pipelines, with a run UI."
    link https://orchestrator.rs
  }
  rivers -[realizes]-> lakehouse.orchestration "realizes the orchestration capability"

  // Infrastructure the docs environments run on ----------------------------
  envoy = implementation "Envoy" {
    #infra

    description "Open source edge and service proxy; the gateway that routes requests to each service."
    link https://www.envoyproxy.io
  }

  postgresql = implementation "PostgreSQL" {
    #infra

    description "Open source relational database; the metadata store behind catalog and tracking services."
    link https://www.postgresql.org
  }

  rustfs = implementation "RustFS" {
    #infra

    description "S3-compatible object storage server written in Rust."
    link https://rustfs.com
  }
  rustfs -[implements]-> s3Api "implements"

  amazonS3 = implementation "Amazon S3" {
    #infra

    description "AWS's managed object storage service; the origin of the S3 API."
    link https://aws.amazon.com/s3/
  }
  amazonS3 -[implements]-> s3Api "implements"

  azurite = implementation "Azurite" {
    #infra

    description "Local emulator for Azure Storage, including the Blob service."
    link https://github.com/Azure/Azurite
  }
  azurite -[implements]-> azureBlobApi "emulates"

  azureBlobStorage = implementation "Azure Blob Storage" {
    #infra

    description "Azure's managed object storage service."
    link https://azure.microsoft.com/products/storage/blobs
  }
  azureBlobStorage -[implements]-> azureBlobApi "implements"

  // Omnigent — Databricks' Apache-2.0 AI-agent meta-harness. Deliberately has NO
  // capability edge: it is agent tooling, not a lakehouse capability.
  omnigent = implementation "Omnigent" {
    #service

    description "Open source meta-harness for AI agents: composes, governs, and shares sessions across multiple agent harnesses."

    link https://omnigent.ai
    style {
      icon https://raw.githubusercontent.com/omnigent-ai/omnigent/99e25f6de1ae8c9f31f2a70efbfc09d95fd8884c/editors/vscode/media/omnigent-icon.svg
    }
  }
}
