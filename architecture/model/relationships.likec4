// LOGICAL LAYER — cross-capability relationships of the reference lakehouse.
//
// The core chain: queryEngine -> catalog -> tableFormat -> objectStorage, with
// governance and lineage attaching at resolution/planning time. Foundations and
// concrete formats realize the capabilities. Deployment-specific edges (gateway
// routing, credential vending to external engines) live in deployments.likec4.

model {
  extend lakehouse {

    // --- The core query path -----------------------------------------------

    queryEngine -[resolves]-> catalog "resolves tables through"
    catalog -[flows]-> tableFormat "resolves a table to its format + location"
    queryEngine -[reads]-> tableFormat "reads tables via the format"
    tableFormat -[reads]-> objectStorage "manifests as files in"

    // Governance + lineage attach to the query engine at planning time.
    queryEngine -[enforces]-> governance "policy decided + enforced in-plan (planning-time)"
    queryEngine -[flows]-> lineage "emits column-level lineage (planning-time)"

    // The catalog is the authoritative resource PIP and hosts the PA (vending).
    catalog -[flows]-> governance.pip "serves resource facts (identity, tags, locations)"
    catalog -[vends]-> objectStorage "vends short-lived scoped credentials for"
  }

  // --- Foundations realize the capabilities --------------------------------

  lakehouse.queryEngine -[realizes]-> datafusion "built on"
  delta -[realizes]-> lakehouse.tableFormat "is an open table format"
  iceberg -[realizes]-> lakehouse.tableFormat "is an open table format"
  lakehouse.catalog -[realizes]-> unitycatalog "builds / integrates with"
  lakehouse.catalog -[flows]-> lakekeeper "Iceberg-REST interop (Delta API)" {
    #designed
  }
  lakehouse.governance.pdp -[realizes]-> cedar "decisions computed by"
  lakehouse.lineage -[realizes]-> openlineage "speaks"

  // --- People + external engines -------------------------------------------

  practitioner -[flows]-> lakehouse.queryEngine "queries + governs data"
  platformEngineer -[flows]-> lakehouse "builds + operates"
  agent -[flows]-> lakehouse.lineage "investigates lineage (agent CLIs)"

  // An external engine reads directly once a credential is vended — FGAC bypass.
  lakehouse.catalog -[vends]-> sparkTrino "vends scoped credential to"
  sparkTrino -[reads]-> lakehouse.objectStorage "reads raw files (FGAC bypassed)" {
    #designed
  }
}
