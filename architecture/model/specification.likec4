// Specification for the Open Lakehouse architecture model — the vocabulary of
// element / deployment-node / relationship kinds and tags.
//
// REF-FREE: names and edges only — never a commit SHA or release tag.
// MATURITY-HONEST: designed-but-not-built carries #designed (or #prototype);
// the tag colors render those amber so the model never overstates what exists.
//
// METADATA CONVENTIONS (free-form key/values on elements):
//   canonicalDoc  — path (relative to architecture/) of the NAVIGATION design
//                   doc for this element; used by canonicals.yaml / update skill.
//   sourceRepo    — org/repo identity of a deployment service.
//
// EXPLANATION BINDING: an element's long-form explanation is no longer owned by
// the model. It lives as an ordinary reviewable content page under
// content/**/explanation/ whose frontmatter declares `explains: <element-id>`.
// The site resolves the element ↔ page correlation from that relationship (see
// site/src/graph.ts effectiveRefIds + the ModelContext panel on the doc page).

specification {

  // --- Logical element kinds ----------------------------------------------

  element person {
    style {
      shape person
      color secondary
    }
  }

  // Blog-local sequence diagrams sometimes need protocol participants that are
  // too concrete for the reference capability model. Keep the element kinds
  // here so preview diagrams still use the single estate LikeC4 runtime.
  element participant {
    style {
      shape rectangle
      color primary
    }
  }

  element store {
    notation "Object storage"
    style {
      shape storage
      color muted
    }
  }

  // A technology-agnostic capability of the Agentic Lakehouse
  element capability {
    style {
      color primary
    }
  }

  // A specification: an open protocol or format definition — the contract/API
  // side of the stack (Backstage's first-class "API"). Pure definition, never
  // compute: "just libraries and definitions". Delta / Iceberg (table-format
  // specs), the Iceberg REST & Unity Catalog catalog specs, Parquet, the S3 API.
  // NB: the element-kind id is `openSpecification` because `specification` is a
  // reserved block keyword; its notation/label is simply "Specification".
  element openSpecification {
    notation "Specification / open standard"
    style {
      color sky
      shape rectangle
    }
  }

  // A zero-trust governance role (PAP / PDP / PEP / PIP / PA). Lives inside the
  // governance capability; realized by concrete services in each deployment.
  element role {
    notation "Governance role"
    style {
      shape rectangle
      color indigo
    }
  }

  // A governed asset KIND — the noun the platform manages along the data & AI
  // value chain (table, volume, function, model, agent skill, schema).
  element asset {
    notation "Data & AI asset kind"
    style {
      shape rectangle
      color green
    }
  }

  // A concrete implementation: software that realizes a capability and/or
  // implements a specification. May run as a service or embed as a library.
  element implementation {
    notation "Implementation (software / service)"
    style {
      shape cylinder
      color muted
    }
  }

  // A deployment topology.
  deploymentNode environment {
    notation "Deployment topology"
  }

  // A browser / client-side runtime.
  deploymentNode browser {
    #untrusted

    notation "Browser runtime"

    style {
      shape browser
      color sky
    }
  }

  // A deployed service / process (our repos manifest here).
  deploymentNode service {
    style {
      icon tech:rust
    }
  }

  // A datastore backing a service (object storage buckets, relational store).
  deploymentNode datastore {
    style {
      shape storage
      color muted
    }
  }

  // --- Relationship kinds --------------------------------------------------

  // Generic backbone (ADR-0006): the coarse composition + dependency edges C4 /
  // Backstage assume, so agents can reason over the graph coarsely before
  // drilling into a specific kind.
  //   partOf    — generic COMPOSITION. Added only where nesting does NOT already
  //               imply it (cross-type composition, e.g. impl composed of impl);
  //               never duplicate the containment tree. Asset "belonging" is NOT
  //               partOf — it is carried by `requires` (asset -> capability).
  //   dependsOn — generic DEPENDENCY (fallback when no specific edge fits). The
  //               specific edges below (resolves / reads / vends / consumes /
  //               enforces) are REFINEMENTS of dependsOn and stay the primary
  //               rendering; use dependsOn only when none of them apply.
  relationship partOf                      // generic composition (cross-type)
  relationship dependsOn { line dashed }   // generic dependency; specific edges refine it

  relationship flows                       // generic data / control flow
  relationship realizes { line dotted }    // concrete realizes abstract capability
  relationship resolves                    // query engine resolves via catalog (a dependsOn)
  relationship reads                       // reads bytes / files (a dependsOn)
  relationship vends { color amber }       // catalog vends a scoped credential (a dependsOn)

  // Altitude edges (concept <- specification <- implementation):
  relationship specifies                   // a specification specifies a capability
  relationship implements { line dotted }  // an implementation implements a spec (Backstage providesApi)
  relationship consumes { line dashed }    // an implementation consumes a spec (Backstage consumesApi; a dependsOn)

  // Governed-asset edges (the subject axis — see ADR-0005):
  relationship requires                    // an asset kind requires a capability to be managed
  relationship governs                     // a catalog specification governs an asset kind

  // Zero-trust edges:
  relationship administers                 // PAP administers policy for the PDP
  relationship decides                     // PDP decides
  relationship enforces                    // PEP enforces a PDP decision
  relationship informs { line dashed }     // PIP informs the PDP with facts

  // --- Tags ----------------------------------------------------------------

  // Maturity (drives amber coloring for designed / prototype work).
  tag built
  tag designed { color #f59e0b }     // amber — designed, not built
  tag prototype { color #f59e0b }    // amber — prototype / preview only

  // Governance points (for filtering / coloring the zero-trust decomposition).
  tag pap
  tag pdp
  tag pep
  tag pip

  // Implementation compute posture (intrinsic; complements the deployment layer).
  // #service = runs as a server, #library = embeddable, #infra = managed infra.
  tag service
  tag library
  tag infra

  // Trust posture of a DEPLOYMENT topology / node (never of a logical element).
  tag trusted
  tag untrusted
}
