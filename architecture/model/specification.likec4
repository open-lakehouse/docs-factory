// Specification for the Open Lakehouse architecture model — the vocabulary of
// element / deployment-node / relationship kinds and tags.
//
// Conventions for using this vocabulary are ADR-0008.
//
// METADATA CONVENTIONS (free-form key/values on elements):
//   designDoc     — path (relative to architecture/) of the design doc about this
//                   element. The reader-facing page is the one that `explains:` it.
//   trust         — on a deployment environment: whether it sits inside the
//                   trusted boundary ("trusted") or not.
//   sourceRepo    — org/repo of an implementation or deployment service.
//   license       — an implementation's SPDX license identifier; omitted for
//                   managed services and closed-source software.
//   language      — the language an implementation is written in.
//   pypi / crate / npm — the PyPI project, crates.io crate, or npm package an
//                   implementation installs by; an element carries each it ships.
//   maven         — its Maven `group:artifact`, Scala suffix included.
//   duckdbExtension — the name a DuckDB extension is INSTALLed by.
//   maturity      — the release channel, when it isn't a stable release
//                   ("nightly", "preview").
//   trestleModule / trestleEdge — written by `docsnip envs --fix` on generated
//                   deployment nodes and edges; never by hand.

specification {

  // --- Logical element kinds ----------------------------------------------

  element person {
    style {
      shape person
      color secondary
    }
  }

  // A capability describes and abstract functionality of a Lakehouse that may be realized by several
  // concrete implementations. Often times there are specifications which define properties and
  // behaviors a concrete implementation must adhere to.
  element capability {
    style {
      color primary
    }
  }

  // A concern is a property that spans assets and capabilities rather than
  // sitting in the read path (governance, lineage, observability). It
  // `appliesTo` what it spans; implementations `realizes` it like a capability.
  element concern {
    style {
      shape component
      color amber
    }
  }

  // A specification defines properties and behaviors a concrete implementation
  // must adhere to. Often times specifications are open standards or formats
  // that are implemented by multiple concrete implementations. Specifications
  // are often associated with a capability.
  element openSpecification {
    notation "Specification / open standard"
    style {
      color sky
      shape rectangle
    }
  }

  // A governed asset KIND — the noun the platform manages along the data & AI
  // value chain (table, volume, function, model, agent skill, schema).
  element asset {
    style {
      shape rectangle
      color green
    }
  }

  // A concrete implementation: software that realizes a capability and/or
  // implements a specification. May run as a service or embed as a library.
  element implementation {
    notation "Implementation (software / service)"
    style {
      shape cylinder
      color muted
    }
  }

  // A deployment topology.
  deploymentNode environment {
    notation "Deployment topology"
  }

  // A deployed service / process (our repos manifest here).
  deploymentNode service

  // A datastore backing a service (object storage buckets, relational store).
  deploymentNode datastore {
    style {
      shape storage
      color muted
    }
  }

  // --- Relationship kinds --------------------------------------------------

  // Generic backbone (ADR-0006). `dependsOn` is the fallback dependency; the
  // specific dependency edges below refine it, so a coarse traversal takes the
  // union of `dependsOn` and its refinements. Use `dependsOn` only when no
  // specific edge fits: the capability chain, credential -> issuer, concern ->
  // capability.
  relationship dependsOn { line dashed }

  // Dependency refinements (ADR-0008):
  relationship registeredIn                // asset -> catalog: the catalog records it
  relationship locatedAt { line dashed }   // asset -> objectStorage or volume: it names a path there
  relationship derivedFrom                 // asset -> asset, type-level: an instance can be defined over instances of the target
  relationship builtOn                     // implementation -> implementation: the required core it can't run without
  relationship integrates                  // host engine -> the plugin or library that adds a spec's support to it
  relationship uses                        // person -> capability; deployment node -> node

  relationship flows                       // data or control flow (orchestration, routes, dynamic views)
  relationship realizes { line dotted }    // an implementation realizes a capability or concern

  // Altitude edges (concept <- specification <- implementation):
  relationship specifies                   // a specification specifies a capability
  relationship implements { line dotted }  // an implementation implements a spec (Backstage providesApi)
  relationship consumes { line dashed }    // an implementation consumes a spec (Backstage consumesApi; a dependsOn)

  // Governed-asset edges (the subject axis — see ADR-0005):
  relationship governs                     // a catalog specification governs an asset kind
  relationship operatesOn { line dashed }  // an implementation can act on an asset kind; not proof of a journey

  // Cross-cutting edge (ADR-0007): a concern spans an asset kind or capability.
  // One kind for every concern; the verb goes in the title.
  relationship appliesTo { line dotted }

  // --- Tags ----------------------------------------------------------------
  // Compute posture of an implementation: runs as a service, embeds as a
  // library, is a client of a service (CLI, SDK, agent-tool bridge), or is
  // infrastructure the environments run on.
  tag service
  tag library
  tag client
  tag infra
  // Loads only into the host that `integrates` it (a Spark connector, a DuckDB
  // extension). Its support is the host's, so it is never a path candidate or
  // an implementation card of its own.
  tag extension
  tag generated   // rendered from a Trestle plan; excluded from estate views
  // On a `realizes` edge: the implementation meets the target only together
  // with another contributor. Whether the target is fully met is a property of
  // an environment's deployed instances, never of one edge (ADR-0007).
  tag partial
  // Designed-but-not-built work. Declared so the DSL accepts them; do not
  // bulk-tag the estate — apply on a reconciliation pass when a source repo
  // shows the work is unbuilt. Amber so views do not look like production.
  tag designed {
    color #d97706
  }
  tag prototype {
    color #d97706
  }
  // A positive selection for the docs sites' public artifacts (concepts.json,
  // JSON-LD, model: links): only elements tagged here leave the factory, and an
  // edge only when both ends are public. A ready page citing an element doesn't
  // publish it.
  tag public
}
