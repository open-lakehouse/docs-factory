views {

  dynamic view ucDeltaApi_managedTableFlow {
    variant sequence
    title "UC Delta API"
    description "
      The end-to-end managed-table lifecycle from the Unity Catalog managed-tables spec.
    "

    // --- Discovery ---------------------------------------------------------
    lakehouse.queryEngine -> unityCatalogSpec "GET /delta/v1/config (negotiate endpoints + protocol-version)" {
      notes "
        **Handshake.** Before touching any table, the client asks the catalog
        two things: *'which API endpoints do you support?'* and *'which
        protocol version should we speak?'* The client sends the highest
        versions it can handle; the server replies with the version they'll
        both use. This keeps a new client and an older server (or vice versa)
        talking the same language.
      "
    }

    // --- CREATE ------------------------------------------------------------
    lakehouse.queryEngine -> unityCatalogSpec "POST .../staging-tables { name }" {
      notes "
        **Reserve a spot.** The client asks the catalog to set aside a place
        for a brand-new table, passing just the name. Nothing is committed
        yet — think of it as claiming a plot of land before you build on it.
      "
    }

    unityCatalogSpec -> lakehouse.queryEngine "table-id, location, READ_WRITE credential, required-protocol" {
      notes "
        **The starter kit.** The catalog hands back everything the client
        needs to build the table: a unique **table-id**, the **location** in
        cloud storage where files will go, a short-lived **READ_WRITE
        credential** to write there, and the **required-protocol** — the
        minimum Delta features this table must declare.
      "
    }

    lakehouse.queryEngine -> lakehouse.objectStorage "write _delta_log/0.json (schema, protocol, io.unitycatalog.tableId)" {
      notes "
        **Lay the foundation.** Using the vended credential, the client writes
        the very first Delta log file, `0.json`, directly to storage. It
        records the table's schema, the required protocol, and stamps in the
        `io.unitycatalog.tableId` so the file is provably tied to the id the
        catalog just reserved.
      "
    }

    lakehouse.queryEngine -> unityCatalogSpec "POST .../tables (promote: columns, protocol, properties)" {
      notes "
        **Make it official.** The client tells the catalog *'I've written
        version 0 — please promote this staging table into a real, managed
        table.'* It echoes back the columns, protocol, and properties so the
        catalog's record matches what's on disk.
      "
    }

    unityCatalogSpec -> lakehouse.queryEngine "loadTable response (table-uuid, etag, version 0)" {
      notes "
        **Table is live.** The catalog confirms the table now exists and
        returns its current state: the **table-uuid**, an **etag** (a version
        fingerprint used to detect conflicts), and the fact that it sits at
        **version 0**. Creation is done.
      "
    }

    // --- COMMIT (INSERT) ---------------------------------------------------
    lakehouse.queryEngine -> unityCatalogSpec "GET .../tables/{table} (loadTable: current etag + uuid)" {
      notes "
        **Check the current state.** To append data, the client first reads
        the table to learn where it stands — the latest **etag** and
        **uuid**. It needs these so the catalog can later verify that nothing
        else changed the table in the meantime.
      "
    }

    lakehouse.queryEngine -> lakehouse.objectStorage "write _delta_log/_staged_commits/<v>.<uuid>.json" {
      notes "
        **Stage the change.** The client writes its new commit as a *staged*
        file (`<version>.<uuid>.json`) in the `_staged_commits` folder. It's
        fully written but not yet part of the table's official history — the
        catalog hasn't blessed it, so no reader will see it.
      "
    }

    lakehouse.queryEngine -> unityCatalogSpec "POST .../tables/{table} { requirements: [assert-table-uuid, assert-etag], updates: [add-commit] }" {
      notes "
        **Ask for a ratify.** The client asks the catalog to accept the staged
        commit. The **requirements** are safety guards — *'only if the table
        is still this uuid and this etag'* — so two writers can't clobber each
        other. The **add-commit** update points at the staged file. The
        catalog is the referee: it approves at most one commit per version.
      "
    }

    unityCatalogSpec -> lakehouse.queryEngine "ratified — loadTable with the new commit" {
      notes "
        **Accepted.** The catalog ratified the commit: it's now the official
        version, even though the file still lives in `_staged_commits`. The
        catalog returns the updated table state, including the new etag.
      "
    }

    lakehouse.queryEngine -> lakehouse.objectStorage "publish _delta_log/<v>.json (vended credential)" {
      notes "
        **Publish.** As a final tidy-up, the client copies the ratified staged
        file to its permanent name, `_delta_log/<v>.json`. Now a plain
        filesystem listing shows the commit too. Publishing happens strictly
        in version order, so the log always reads cleanly from 0 upward.
      "
    }
  }

  dynamic view ucFunctions_oneFunctionManyCallers {
    variant sequence
    title "One catalog function, three callers"
    description "
      A Python function registered once in Unity Catalog, then run by an app,
      by Spark as a session UDF, and by an agent's tool loop. The catalog checks
      who may fetch it; every caller runs the body on its own machine.
    "

    // --- Register once -----------------------------------------------------
    unityCatalogAi -> unityCatalogServer "create_python_function: signature, docstring, body" {
      notes "
        **Register once.** `unitycatalog-ai` reads the function's type hints,
        Google-style docstring, and source, and stores them under a three-part
        name such as `tools.pricing.order_total`. The server stores text and
        metadata. It never runs the body.
      "
    }

    // --- App or notebook ---------------------------------------------------
    unityCatalogAi -> unityCatalogServer "execute_function: fetch by name (EXECUTE, USE SCHEMA, USE CATALOG)" {
      notes "
        **Fetch.** A call starts by fetching the stored definition. With
        authorization enabled, the server's source returns it only to a caller
        with `EXECUTE` on the function plus `USE SCHEMA` and `USE CATALOG` (or
        ownership in their place). The docs haven't run these rules with
        authorization enabled.
      "
    }
    unityCatalogAi -> unityCatalogAi "rebuild and run in a sandboxed child process" {
      notes "
        **Run on the caller's side.** The client rebuilds the function as Python
        and runs it in a child process by default, with blocked imports and
        time and CPU limits. Local mode runs it in the calling process
        instead, with nothing blocked. The client caches the rebuilt function
        the first time it runs it: after another client replaces the function,
        this one keeps running the old body until it calls
        `clear_function_cache()` or is created again.
      "
    }

    // --- Query engine ------------------------------------------------------
    unityCatalogAi -> apacheSpark "get_function_as_callable, then spark.udf.register" {
      notes "
        **Spark gets a session copy.** The Unity Catalog Spark connector
        resolves tables, not functions, so the driver fetches the Python
        function with `unitycatalog-ai` and registers it as a session UDF with
        the stored return type. SQL and DataFrames call it by its short name,
        and Spark's Python workers run it. Like the app's cached copy, the
        session copy doesn't follow later replaces in the catalog, and it keeps
        running after a delete, until you fetch and register it again.
      "
    }

    // --- Agent tool loop ---------------------------------------------------
    unityCatalogLangChain -> unityCatalogServer "UCFunctionToolkit: fetch each listed function" {
      notes "
        **Build tools from the record.** The toolkit fetches each function you
        list by name and builds a tool from the stored signature and docstring:
        a LangChain tool, an OpenAI Chat Completions definition, or an
        Anthropic Messages tool, depending on the package.
      "
    }
    unityCatalogLangChain -> agent "tool definitions: tools__pricing__order_total, description, JSON Schema" {
      notes "
        **What the model sees.** The tool name is the full name with `__` in
        place of the dots, the description is the docstring's summary, and the
        arguments carry their `Args:` descriptions. The model never sees the
        source code.
      "
    }
    agent -> unityCatalogLangChain "tool call: name + JSON arguments" {
      notes "
        **The model only asks.** A tool call is a name and arguments. Your code
        decides whether to run it, so check the name against the toolkit
        before you do.
      "
    }
    unityCatalogLangChain -> unityCatalogAi "execute_function (metadata fetched again, EXECUTE checked again)" {
      notes "
        **Same path as the app.** The client fetches the function's metadata
        again on every call, so the grant check applies each time, and runs it
        in the sandbox on the agent's machine. The body it runs is the one it
        cached on the first call, the same as in the app. The JSON result goes
        back to the model as the tool's answer.
      "
    }
  }
}
