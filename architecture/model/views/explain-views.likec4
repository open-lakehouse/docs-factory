// Scoped element views for explanation pages (`explains:` in content/). One
// `view of <element>` per capability, concern, and specification, each an
// ad-hoc neighborhood (`include *` = the element plus its direct neighbors).
// The review preview seeds the diagram with the element's own view
// (`element.defaultView`) instead of a whole-estate reference view. There is
// no `/explain/<id>` route; the canonical URL is the content page.
//
// Convention: id `explain_<element>`, title "<Title> — in context".

views {

  // --- Capabilities --------------------------------------------------------
  view explain_catalog of lakehouse.catalog {
    title "Catalog — in context"
    include *
    autoLayout LeftRight
  }

  view explain_queryEngine of lakehouse.queryEngine {
    title "Query engine — in context"
    include *
    autoLayout LeftRight
  }

  view explain_orchestration of lakehouse.orchestration {
    title "Orchestration — in context"
    include *
    autoLayout LeftRight
  }

  view explain_tableFormat of lakehouse.tableFormat {
    title "Open table format — in context"
    include *
    autoLayout LeftRight
  }

  view explain_fileFormat of lakehouse.fileFormat {
    title "File format — in context"
    include *
    autoLayout LeftRight
  }

  view explain_objectStorage of lakehouse.objectStorage {
    title "Object storage — in context"
    include *
    autoLayout LeftRight
  }

  view explain_modelTracking of lakehouse.modelTracking {
    title "Model tracking — in context"
    include *
    autoLayout LeftRight
  }

  view explain_sharing of lakehouse.sharing {
    title "Sharing — in context"
    include *
    autoLayout LeftRight
  }

  view explain_interactiveDevelopment of lakehouse.interactiveDevelopment {
    title "Interactive development — in context"
    include *
    autoLayout LeftRight
  }

  // --- Concerns ----------------------------------------------------------
  view explain_governance of lakehouse.governance {
    title "Governance — in context"
    include *
    autoLayout LeftRight
  }

  view explain_lineage of lakehouse.lineage {
    title "Lineage — in context"
    include *
    autoLayout LeftRight
  }

  view explain_observability of lakehouse.observability {
    title "Observability — in context"
    include *
    autoLayout LeftRight
  }

  view explain_authentication of lakehouse.governance.authentication {
    title "Authentication — in context"
    include *
    autoLayout LeftRight
  }

  view explain_authorization of lakehouse.governance.authorization {
    title "Authorization — in context"
    include *
    autoLayout LeftRight
  }

  view explain_fineGrainedAccess of lakehouse.governance.fineGrainedAccess {
    title "Fine-grained access — in context"
    include *
    autoLayout LeftRight
  }

  // --- Specifications ------------------------------------------------------
  view explain_deltaSpec of deltaSpec {
    title "Delta Lake — in context"
    include *
    autoLayout LeftRight
  }

  view explain_icebergSpec of icebergSpec {
    title "Apache Iceberg — in context"
    include *
    autoLayout LeftRight
  }

  view explain_ucSpec of ucSpec {
    title "Unity Catalog — in context"
    include *
    autoLayout LeftRight
  }

  view explain_icebergRestSpec of icebergRestSpec {
    title "Iceberg REST Catalog — in context"
    include *
    autoLayout LeftRight
  }

  view explain_openSharingSpec of openSharingSpec {
    title "Open Sharing — in context"
    include *
    autoLayout LeftRight
  }

  view explain_parquetSpec of parquetSpec {
    title "Apache Parquet — in context"
    include *
    autoLayout LeftRight
  }

  view explain_s3Api of s3Api {
    title "S3 API — in context"
    include *
    autoLayout LeftRight
  }

  view explain_azureBlobApi of azureBlobApi {
    title "Azure Blob Storage API — in context"
    include *
    autoLayout LeftRight
