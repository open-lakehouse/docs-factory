// LOGICAL views — the abstract reference lakehouse.
// Deployment (concrete) views live in deployment-views.likec4; sequence views in
// docs-views.likec4 and blog-views.likec4.

views {

  // --- The reference lakehouse in context ----------------------------------
  view referenceContext {
    title "Reference Open Lakehouse — context"
    description "The abstract, technology-agnostic lakehouse: the people who use it and its capabilities, along the chain query engine -> catalog -> table format -> file format -> object storage. Specifications and implementations are in technologyCatalog, asset kinds in assetGovernanceBreadth and assetCapabilities, and the concerns that span them in concernMatrix."

    include
      practitioner,
      platformEngineer,
      agent,
    // expand the lakehouse into its capabilities
      lakehouse,
      lakehouse.*,

    // asset kinds and concerns get their own views
    exclude
      element.kind == asset,
      element.kind == concern,
      element.tag == #generated
    autoLayout LeftRight
  }

  // --- Technology catalog: capabilities <- specifications ---------------------
  view technologyCatalog {
    title "Technology catalog — capabilities and specifications"
    description "Which open specification specifies each capability and concern. The implementations that implement or realize them are in one view per area: techQueryEngines, techCatalogs, techFormatsStorage, techConcerns, techPlatform."

    include
      lakehouse.*,
      element.kind == openSpecification

    exclude
      element.kind == asset,
      element.tag == #generated
    autoLayout LeftRight
  }

  // The per-area views below list their elements by id, so every edge between
  // them is drawn. Each implementation and specification belongs in at least
  // one of them.

  view techQueryEngines {
    title "Technology — query engines and their integrations"
    description "The engines that realize the query engine, the query APIs they serve, and the plugins and libraries each integrates for a catalog or table format, with the specs those carry (ADR-0008)."

    include
      lakehouse.queryEngine,
      sparkConnectSpec, flightSqlSpec, openCypherSpec,
      datafusion, apacheSpark, duckdb, polars, daft, hydrofoil, puppygraph,
      unityCatalogSpark, icebergSparkRuntime, deltaSpark,
      duckdbUnityCatalog, duckdbDelta, duckdbIceberg, deltaRs,
      unityCatalogSpec, unityCatalogDeltaApiSpec, icebergRestSpec, deltaSpec, icebergSpec
    autoLayout LeftRight
  }

  view techCatalogs {
    title "Technology — catalogs and their clients"
    description "The catalog specifications, the servers that implement them, the store they keep metadata in, and the clients that call them."

    include
      lakehouse.catalog, lakehouse.metadataStore,
      unityCatalogSpec, unityCatalogDeltaApiSpec, icebergRestSpec,
      unityCatalogServer, lakekeeper, mangrove, postgresql,
      unityCatalogCli, unityCatalogPythonSdk, unityCatalogAi, unityCatalogLangChain, pyIceberg
    autoLayout LeftRight
  }

  view techFormatsStorage {
    title "Technology — table formats, file formats, and object storage"
    description "The format and storage specifications, the libraries that read and write each format or talk to storage directly, and the stores that implement the storage APIs."

    include
      lakehouse.tableFormat, lakehouse.fileFormat, lakehouse.objectStorage,
      deltaSpec, icebergSpec, parquetSpec, s3Spec, azureBlobSpec, gcsSpec,
      deltaRs, pyIceberg, deltaSpark, icebergSparkRuntime, duckdbDelta, duckdbIceberg,
      objectStore, obstore,
      rustfs, amazonS3, azurite, azureBlobStorage
    autoLayout LeftRight
  }

  view techConcerns {
    title "Technology — governance, lineage, and observability"
    description "The implementations that realize each concern or one of governance's facets, #partial where they meet it only together with another contributor."

    include
      lakehouse.governance.authentication,
      lakehouse.governance.authorization,
      lakehouse.governance.fineGrainedAccess,
      lakehouse.lineage, lakehouse.observability,
      openLineageSpec, otlpSpec,
      unityCatalogServer, lakekeeper, hydrofoil, authelia, openPolicyAgent,
      headwaters, jaeger
    autoLayout LeftRight
  }

  view techPlatform {
    title "Technology — model tracking, notebooks, orchestration, sharing, and the gateway"
    description "The platform capabilities beside the read path and what realizes them. Omnigent is agent tooling with no capability, and Envoy the gateway the docs environments route through."

    include
      lakehouse.modelTracking, lakehouse.interactiveDevelopment,
      lakehouse.orchestration, lakehouse.sharing,
      openSharingSpec,
      mlflow, marimo, rivers, omnigent, envoy
    autoLayout LeftRight
  }

  // --- Concerns: what governance, lineage, and observability span ---------
  view concernMatrix {
    title "Cross-cutting concerns"
    description "Governance, lineage, and observability are concerns, not layers in the read path: each appliesTo the asset kinds or capabilities it spans, and implementations realize them like capabilities. Governance splits into authentication, authorization, and fine-grained access; a #partial realizes edge meets a facet only together with another contributor."

    include
      element.kind == concern,
      element.kind == asset,
      lakehouse.queryEngine,
      lakehouse.catalog,
      lakehouse.orchestration

    exclude element.tag == #generated
    autoLayout LeftRight
  }

  // --- Governed asset kinds: catalog breadth (the hero view) ---------------
  view assetGovernanceBreadth {
    title "Governed asset kinds — catalog breadth"
    description "Which asset kinds (UC 'securables') each catalog specification governs. Unity Catalog governs the full data & AI set (tables, views, volumes, functions, models, agent skills); the Iceberg REST catalog is table-centric (namespaces, tables, views). The breadth gap is a structural property of the model, not prose."

    include
      unityCatalogSpec,
      icebergRestSpec,
      element.kind == asset

    // asset-to-asset edges belong to assetCapabilities
    exclude
      element.kind == asset -> element.kind == asset
    autoLayout LeftRight
  }

  // --- Governed asset kinds: what each sits on ------------------------------
  view assetCapabilities {
    title "Governed asset kinds — capabilities they sit on"
    description "Every asset kind is registered in the catalog. A table is laid out in a table format, the kinds that name a storage path are located in object storage, views are defined over tables, and models and agent skills depend on model tracking and sharing."

    include
      element.kind == asset,
    // only the capabilities an asset kind sits on
      lakehouse.catalog,
      lakehouse.queryEngine,
      lakehouse.tableFormat,
      lakehouse.objectStorage,
      lakehouse.credentialIssuer,
      lakehouse.modelTracking,
      lakehouse.sharing

    // the capability chain is referenceContext's; here it only crowds the assets
    exclude
      * -> * where source.kind is capability and target.kind is capability
    autoLayout LeftRight
  }
}
