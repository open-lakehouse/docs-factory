// LOGICAL views — the abstract reference lakehouse.
// Deployment (concrete) views live in deployment-views.likec4; sequence views in
// docs-views.likec4 and blog-views.likec4.

views {

  // --- The reference lakehouse in context ----------------------------------
  view referenceContext {
    title "Reference Open Lakehouse — context"
    description "The abstract, technology-agnostic lakehouse: the people who use it and its capabilities, along the chain query engine -> catalog -> table format -> file format -> object storage. Specifications and implementations are in technologyCatalog, asset kinds in assetGovernanceBreadth and assetCapabilities, and the concerns that span them in concernMatrix."

    include
      practitioner,
      platformEngineer,
      agent,
    // expand the lakehouse into its capabilities
      lakehouse,
      lakehouse.*,

    // asset kinds and concerns get their own views
    exclude
      element.kind == asset,
      element.kind == concern,
      element.tag == #generated
    autoLayout LeftRight
  }

  // --- Technology catalog: capabilities <- specifications <- implementations
  view technologyCatalog {
    title "Technology catalog — capabilities, specifications, implementations"
    description "How concrete technology maps onto the reference architecture: a specification `specifies` the capability it defines; an implementation `implements` a specification or `realizes` a capability directly (query engines have no shared spec). Compute posture (#service / #library / #client / #infra) is intrinsic; running instances live in the deployment views."

    include
      lakehouse.*,
      element.kind == openSpecification,
      element.kind == implementation,

    exclude
      element.kind == asset,
      element.tag == #generated
    autoLayout LeftRight
  }

  // --- Concerns: what governance, lineage, and observability span ---------
  view concernMatrix {
    title "Cross-cutting concerns"
    description "Governance, lineage, and observability are concerns, not layers in the read path: each appliesTo the asset kinds or capabilities it spans, and implementations realize them like capabilities. Governance splits into authentication, authorization, and fine-grained access; a #partial realizes edge meets a facet only together with another contributor."

    include
      element.kind == concern,
      element.kind == asset,
      lakehouse.queryEngine,
      lakehouse.catalog,
      lakehouse.orchestration

    exclude element.tag == #generated
    autoLayout LeftRight
  }

  // --- Governed asset kinds: catalog breadth (the hero view) ---------------
  view assetGovernanceBreadth {
    title "Governed asset kinds — catalog breadth"
    description "Which asset kinds (UC 'securables') each catalog specification governs. Unity Catalog governs the full data & AI set (tables, views, volumes, functions, models, agent skills); the Iceberg REST catalog is table-centric (namespaces, tables, views). The breadth gap is a structural property of the model, not prose."

    include
      unityCatalogSpec,
      icebergRestSpec,
      element.kind == asset

    // asset-to-asset edges belong to assetCapabilities
    exclude
      element.kind == asset -> element.kind == asset
    autoLayout LeftRight
  }

  // --- Governed asset kinds: what each sits on ------------------------------
  view assetCapabilities {
    title "Governed asset kinds — capabilities they sit on"
    description "Every asset kind is registered in the catalog. A table is laid out in a table format, the kinds that name a storage path are located in object storage, views are defined over tables, and models and agent skills depend on model tracking and sharing."

    include
      element.kind == asset,
    // only the capabilities an asset kind sits on
      lakehouse.catalog,
      lakehouse.queryEngine,
      lakehouse.tableFormat,
      lakehouse.objectStorage,
      lakehouse.credentialIssuer,
      lakehouse.modelTracking,
      lakehouse.sharing

    // the capability chain is referenceContext's; here it only crowds the assets
    exclude
      * -> * where source.kind is capability and target.kind is capability
    autoLayout LeftRight
  }
}
