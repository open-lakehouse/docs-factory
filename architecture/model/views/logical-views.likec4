// LOGICAL views — the abstract reference lakehouse.
// Deployment (concrete) views live in deployment-views.likec4; flows in flows.likec4.

views {

  // --- The reference lakehouse in context ----------------------------------
  view referenceContext {
    title "Reference Open Lakehouse — context"
    description "The abstract, technology-agnostic lakehouse: its capabilities and the people who use it. Specifications specify a capability and implementations realize one (see the technology catalog view for the full mapping). The concerns that span them have their own view, concernMatrix."

    include
      practitioner,
      platformEngineer,
      agent,
    // expand the lakehouse into its capabilities
      lakehouse,
      lakehouse.*,

    // asset kinds and concerns get their own views
    exclude
      element.kind == asset,
      element.kind == concern,
      element.tag == #generated
    autoLayout LeftRight
  }

  // --- Technology catalog: capabilities <- specifications <- implementations
  view technologyCatalog {
    title "Technology catalog — capabilities, specifications, implementations"
    description "How concrete technology maps onto the reference architecture: a specification `specifies` the capability it defines; an implementation `implements` a specification or `realizes` a capability directly (query engines have no shared spec). Compute posture (#service / #library / #infra) is intrinsic; running instances live in the deployment views."

    include
      lakehouse.*,
    // specifications (the open standards / APIs)
      deltaSpec,
      icebergSpec,
      ucSpec,
      icebergRestSpec,
      openSharingSpec,
      parquetSpec,
      s3Api,
      azureBlobApi,
      openLineageSpec,
      otlpSpec,
    // implementations (concrete software)
      element.kind == implementation,

    exclude
      element.kind == asset,
      element.tag == #generated
    autoLayout LeftRight
  }

  // --- Capability map: inside the lakehouse --------------------------------
  view capabilityMap of lakehouse {
    title "Reference Open Lakehouse — capabilities"
    description "The capability chain: query engine -> catalog -> table format -> file format -> object storage. Governance, lineage, and observability are concerns that attach at planning time; concernMatrix shows them. Delta & Iceberg are peer specifications of the table-format capability."

    include *

    // asset kinds and concerns have their own views
    exclude
      element.kind == asset,
      element.kind == concern,
      element.tag == #generated
    autoLayout LeftRight
  }

  // --- Concerns: what governance, lineage, and observability span ---------
  view concernMatrix {
    title "Cross-cutting concerns"
    description "Governance, lineage, and observability are concerns, not layers in the read path: each appliesTo the asset kinds or capabilities it spans, and implementations realize them like capabilities."

    include
      element.kind == concern,
      element.kind == asset,
      lakehouse.queryEngine,
      lakehouse.catalog,
      lakehouse.orchestration

    exclude element.tag == #generated
    autoLayout LeftRight
  }

  // --- Governed asset kinds: catalog breadth (the hero view) ---------------
  view assetGovernanceBreadth {
    title "Governed asset kinds — catalog breadth"
    description "Which asset kinds (UC 'securables') each catalog specification governs. Unity Catalog governs the full data & AI set (tables, volumes, functions, models, agent skills); the Iceberg REST catalog is table-centric (namespaces + tables). The breadth gap is a structural property of the model, not prose."

    include
      ucSpec,
      icebergRestSpec,
      lakehouse,
      element.kind == asset
    autoLayout LeftRight
  }

  // --- Governed asset kinds: capabilities required to manage them -----------
  view assetCapabilities {
    title "Governed asset kinds — capabilities required"
    description "The capabilities each asset kind is materialized on: a table on a table format, object storage, and the catalog that coordinates its commits; a volume and a model on object storage."

    include
      lakehouse,
      lakehouse.*,
      element.kind == asset

    autoLayout LeftRight
  }
}
