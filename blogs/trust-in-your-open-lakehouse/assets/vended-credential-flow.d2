direction: right

# Sequence diagram
sequence: Credential Vending Flow {
  shape: sequence_diagram

  client: Client
  catalog: Unity Catalog\n(PIP + PDP)
  storage: Object Store\n(PEP)

  client -> catalog: "requestCredential(path, privilege)"
  catalog -> catalog: "evaluate policy\n(PDP checks PIP)"
  catalog -> client: "temporaryCredential{token, expiry}"
  client -> storage: "read/write(path, token)"
  storage -> storage: "validate token\n& enforce access"
  storage -> client: "data / ack"
}
