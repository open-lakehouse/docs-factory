direction: right

client: Client {
  shape: person
}

# Architecture diagram
arch: Architecture {
  label: "Trusted System"

  catalog: Catalog {
    label: "Catalog\n(PIP + PDP)"
    style.fill: "#ede9fe"
    style.stroke: "#7c3aed"
  }

  storage: Object Store {
    label: "Object Store\n(PEP)"
    shape: cylinder
    style.fill: "#dbeafe"
    style.stroke: "#2563eb"
  }
}

client <-> arch.catalog
client -> arch.storage
