{
  "version": 1,
  "environments": {
    "uc-aws": {
      "ports": [
        8080,
        9000
      ],
      "client-env": {
        "AWS_ALLOW_HTTP": "true",
        "AWS_ENDPOINT_URL": "http://localhost:9000",
        "AWS_ENDPOINT_URL_S3": "http://localhost:9000",
        "AWS_REGION": "us-east-1",
        "UNITY_CATALOG_URL": "http://localhost:8080/api/2.1/unity-catalog"
      },
      "files": [
        ".env",
        ".gitignore",
        "LAYOUT.md",
        "client/container.env",
        "client/host.env",
        "compose.yaml",
        "image/Dockerfile",
        "image/run-as-owner",
        "image/uc",
        "modules/envoy/certs.sh",
        "modules/envoy/compose.yaml",
        "modules/envoy/envoy.yaml",
        "modules/postgres/.env/db.env",
        "modules/postgres/compose.yaml",
        "modules/postgres/init-databases.sh",
        "modules/postgres/secrets/postgres_password",
        "modules/rustfs/.env/rustfs.env",
        "modules/rustfs/compose.yaml",
        "modules/rustfs/sts_shim.py",
        "modules/unity-catalog/compose.yaml",
        "modules/unity-catalog/secrets/hibernate.properties",
        "modules/unity-catalog/secrets/server.properties"
      ]
    }
  }
}
