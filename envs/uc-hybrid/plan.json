  "deploy": [
    {
      "order": 1,
      "phase": "provision",
      "module": "aws-s3",
      "id": "buckets",
      "title": "Create the buckets",
      "instructions": "Create the buckets the stack uses: `unity`, through the S3-compatible API at `${AWS_ENDPOINT_URL}`.\nThe script needs the AWS CLI, signed in with credentials that may create buckets (a profile,\nSSO, or keys). Set `AWS_ACCESS_KEY_ID` and `AWS_SECRET_ACCESS_KEY` to a\nkey that may read and write them.",
      "script": "deploy/aws-s3-buckets.sh"
    },
    {
      "order": 2,
      "phase": "provision",
      "module": "hosted-postgres",
      "id": "server",
      "title": "Create the Neon project",
      "instructions": "Create a Neon project for the stack's databases. The script needs\n[`neonctl`](https://neon.tech/docs/reference/neon-cli), signed in (`neonctl auth`, or\n`NEON_API_KEY` set), and `jq`. It creates the project `trestle-uc-hybrid` unless it exists\n(in `NEON_REGION`, default `aws-us-east-2`), then saves its id as `NEON_PROJECT_ID` and its connection details as `PGHOST`, `PGUSER`, `PGPASSWORD` in `secrets.env`.",
      "script": "deploy/hosted-postgres-server.sh"
    },
    {
      "order": 3,
      "phase": "provision",
      "module": "hosted-postgres",
      "id": "databases",
      "title": "Create the databases",
      "instructions": "Create the databases the stack uses: `unitycatalog`. The script adds each one missing to the Neon project\n`NEON_PROJECT_ID` with `neonctl`.",
      "script": "deploy/hosted-postgres-databases.sh"
    },
    {
      "order": 4,
      "phase": "configure",
      "id": "secrets",
      "title": "Supply the hosted resources' secrets",
      "instructions": "The hosted resources read `AWS_ACCESS_KEY_ID`, `AWS_ENDPOINT_URL`, `AWS_SECRET_ACCESS_KEY`, `PGHOST`, `PGPASSWORD`, `PGUSER`. Set them in `secrets.env` beside `env.toml` (git-ignored; the scripts above save what they create there) or export them, then render again so the stack picks them up:\n\n```bash\ntrestle env render .\n```"
    },
    {
      "order": 5,
      "phase": "start",
      "id": "up",
      "title": "Start the stack",
      "instructions": "Start every service and wait until each one is healthy:\n\n```bash\ndocker compose up -d --wait\n```\n\nEach service is then published on its own host port. [LAYOUT.md](LAYOUT.md) lists every route and address."
    }
  ]
