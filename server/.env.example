# Local dev config for the review backend. Copy to server/.env (gitignored).
# docker-compose and the just recipes read these; the code composes DATABASE_URL
# from the parts when DATABASE_URL itself is not set.

# Local Postgres (docker-compose) credentials + host port.
PGUSER=review
PGPASSWORD=review
PGDATABASE=review
PGHOST=localhost
PGPORT=5433

# Auth mode for local dev. Phase 1: only "anon" is implemented. Phase 2 adds
# "mock" (local impersonation). Never "neon" locally.
AUTH_MODE=anon

# Shared secret the server requires for RegisterVersion. Any non-empty value
# locally; a real secret in prod.
BUILD_SECRET=local-dev-secret

# Live comment updates (Phase 4B). When "true", serve the /events/comments SSE
# endpoint that relays Postgres NOTIFYs as invalidation hints. Off by default —
# polling is the guaranteed path; SSE holds a connection open, which is an
# anti-pattern on evictable serverless compute. The client opts in separately
# with VITE_REVIEW_SSE=true (site/.env).
REVIEW_SSE_ENABLED=false
