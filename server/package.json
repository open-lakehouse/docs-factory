{
  "name": "docs-factory-review-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Review & release API for docs-factory: a Hono + Connect RPC app served from a Neon Function in prod and a local Node entrypoint in dev. DB-authoritative review layer (Neon Postgres).",
  "scripts": {
    "dev": "bun --watch run src/dev-server.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.9.0",
    "@connectrpc/connect": "^2.1.0",
    "@connectrpc/connect-node": "^2.1.0",
    "@hono/node-server": "^1.19.0",
    "hono": "^4.10.0",
    "jose": "^6.2.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.0",
    "typescript": "^5.8.3"
  }
}
