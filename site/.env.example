# Base URL of the review API (the Neon Function in prod; the local dev-server
# in dev). Defaults to http://localhost:8787 when unset.
VITE_API_URL=http://localhost:8787

# The project's Neon Auth URL — the full URL from the Neon console, incl. path,
# e.g. https://ep-….neonauth.<region>.aws.neon.tech/<db>/auth. The SDK client
# points at this to start GitHub sign-in and to read the session token that the
# API is authenticated with (as an Authorization: Bearer header). In prod this
# is injected into Vercel by the Neon↔Vercel integration (Preview + Production);
# leave it unset locally — the dev persona switcher stands in for a real login.
# VITE_NEON_AUTH_URL=
