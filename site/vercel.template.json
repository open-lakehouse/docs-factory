{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://__NEON_FUNCTION_HOST__/:path*" },
    { "source": "/auth/:path*", "destination": "https://__NEON_AUTH_BASE__/:path*" },
    { "source": "/((?!assets/|api/|auth/).*)", "destination": "/index.html" }
  ]
}
