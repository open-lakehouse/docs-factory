{
  "name": "unitycatalog-docs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Static Unity Catalog documentation site. Content, generated data, vendored remark plugins, and public/ are written by the docs-factory emitter (emit/docs); this package only renders them. Every route is prerendered to HTML and hydrated.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/prerender.mjs",
    "preview": "vite preview --port 4322",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mdx-js/react": "^3.1.1",
    "lucide-react": "^1.23.0",
    "minisearch": "^7.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.30.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@mdx-js/rollup": "^3.1.1",
    "@shikijs/rehype": "^4.3.1",
    "@types/mdx": "^2.0.13",
    "@types/node": "^26.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-directive": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.3.1",
    "typescript": "^5.8.3",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.1.3"
  }
}
