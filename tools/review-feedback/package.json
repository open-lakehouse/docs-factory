{
  "name": "review-feedback",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Agent access to docs-factory review feedback: fetch open review threads, locate them in the local checkout, and reply. One core exposed as a CLI and a stdio MCP server.",
  "bin": {
    "review-feedback": "./src/cli.ts"
  },
  "scripts": {
    "cli": "bun --use-system-ca run src/cli.ts",
    "mcp": "bun --use-system-ca run src/mcp.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.9.0",
    "@connectrpc/connect": "^2.1.0",
    "@connectrpc/connect-node": "^2.1.0",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.0",
    "typescript": "^5.8.3"
  }
}
